@model Travel.Web.DTOs.TourDtos.ResultTourDto

@using Travel.Web.DTOs.CommentDtos
@using Travel.Web.DTOs.QuestionDtos

@{
    ViewData["Title"] = Model.TourName;
    Layout = "~/Views/Shared/_SiteLayout.cshtml";

    var comments =
        ViewBag.Comments as List<ResultCommentDto>
        ?? new List<ResultCommentDto>();

    var questions =
        ViewBag.Questions as List<ResultQuestionDto>
        ?? new List<ResultQuestionDto>();
}

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        .tour-detail-page {
            padding: 35px 0 70px;
        }


        /* ÜST BİLGİ */

        .detail-category {
            color: var(--teal);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .detail-title {
            margin: 5px 0 8px;
            font-size: 2.4rem;
            font-weight: 800;
        }

        .detail-location {
            color: var(--muted);
            font-size: .85rem;
        }

            .detail-location i {
                color: var(--teal);
                margin-right: 4px;
            }


        /* KAPAK */

        .detail-cover {
            height: 390px;
            margin-top: 22px;
            border-radius: 20px;
            overflow: hidden;
            background: #e9ecef;
        }

            .detail-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }


        /* GENEL BİLGİ */

        .detail-info-bar {
            margin: 20px 0;
            padding: 16px 20px;
            display: flex;
            gap: 35px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 14px;
        }

        .detail-info-item {
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .detail-info-item i {
                color: var(--teal);
                font-size: 1.2rem;
            }

            .detail-info-item small {
                display: block;
                color: var(--muted);
                font-size: .6rem;
            }

            .detail-info-item strong {
                display: block;
                color: var(--navy);
                font-size: .8rem;
            }


        /* CONTENT */

        .detail-box {
            margin-bottom: 18px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
        }

            .detail-box h3 {
                margin-bottom: 15px;
                font-size: 1.15rem;
                font-weight: 700;
            }

        .detail-description {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            line-height: 1.8;
        }


        /* FEATURES */

        .feature-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .feature-item {
            padding: 7px 11px;
            background: #f4f9f9;
            border-radius: 999px;
            color: var(--navy);
            font-size: .7rem;
            font-weight: 500;
        }

            .feature-item i {
                margin-right: 4px;
                color: var(--teal);
            }


        /* TARİHLER */

        .date-item {
            padding: 12px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eeeae4;
        }

            .date-item:last-child {
                border-bottom: none;
            }

        .date-main {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .8rem;
            font-weight: 600;
        }

            .date-main i {
                color: var(--teal);
            }

        .capacity-badge {
            padding: 5px 9px;
            background: #edf8f7;
            border-radius: 999px;
            color: var(--teal-dark);
            font-size: .65rem;
            font-weight: 600;
        }


        /* PROGRAM */

        .program-item {
            display: flex;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #eeeae4;
        }

            .program-item:last-child {
                border-bottom: none;
            }

        .program-day {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: var(--navy);
            color: white;
            border-radius: 50%;
            font-size: .7rem;
            font-weight: 700;
        }

        .program-content h5 {
            margin: 0 0 4px;
            font-size: .85rem;
            font-weight: 700;
        }

        .program-content p {
            margin: 0 0 7px;
            color: var(--muted);
            font-size: .72rem;
            line-height: 1.6;
        }

        .program-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            color: var(--muted);
            font-size: .65rem;
        }

            .program-meta i {
                color: var(--teal);
            }


        /* REZERVASYON */

        .reservation-card {
            position: sticky;
            top: 95px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(14,42,59,.08);
        }

        .price-label {
            color: var(--muted);
            font-size: .68rem;
        }

        .detail-price {
            margin-bottom: 18px;
            color: var(--navy);
            font-family: 'Sora';
            font-size: 1.8rem;
            font-weight: 800;
        }

            .detail-price small {
                font-family: 'Inter';
                font-size: .65rem;
                font-weight: 400;
                color: var(--muted);
            }

        .reservation-label {
            display: block;
            margin: 12px 0 5px;
            color: var(--navy);
            font-size: .68rem;
            font-weight: 700;
        }

        .reservation-control {
            width: 100%;
            height: 42px;
            padding: 0 11px;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .75rem;
        }

            .reservation-control:focus {
                border-color: var(--teal);
            }


        /* TOPLAM */

        .total-price-box {
            margin-top: 18px;
            padding: 13px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #e5e1db;
            border-bottom: 1px solid #e5e1db;
        }

            .total-price-box span {
                color: var(--muted);
                font-size: .75rem;
            }

            .total-price-box strong {
                color: var(--navy);
                font-family: 'Sora';
                font-size: 1.15rem;
            }


        /* REZERVASYON BUTONU */

        .reservation-btn {
            width: 100%;
            height: 44px;
            margin-top: 18px;
            border: none;
            border-radius: 999px;
            background: var(--teal);
            color: white;
            font-size: .78rem;
            font-weight: 600;
        }

            .reservation-btn:hover {
                background: var(--teal-dark);
            }


        /* FAVORİ */

        .favorite-add-btn {
            width: 100%;
            height: 44px;
            margin-top: 10px;
            background: white;
            color: var(--navy);
            border: 1px solid #e5e1db;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
            transition: .2s;
        }

            .favorite-add-btn:hover {
                color: var(--teal);
                border-color: var(--teal);
                background: #f4f9f9;
            }


        /* YORUM */

        .comment-rating {
            width: 100%;
            height: 42px;
            padding: 0 10px;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .75rem;
        }

            .comment-rating:focus {
                border-color: var(--teal);
            }

        .comment-textarea {
            width: 100%;
            min-height: 110px;
            padding: 12px;
            resize: vertical;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .78rem;
        }

            .comment-textarea:focus {
                border-color: var(--teal);
            }

        .comment-submit-btn {
            margin-top: 10px;
            padding: 9px 18px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
        }

            .comment-submit-btn:hover {
                background: var(--teal-dark);
            }

        .comment-item {
            padding: 16px 0;
            border-bottom: 1px solid #eeeae4;
        }

            .comment-item:last-child {
                border-bottom: none;
            }

        .comment-top {
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .comment-user {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--navy);
            font-size: .75rem;
            font-weight: 600;
        }

            .comment-user i {
                color: var(--teal);
            }

        .comment-date {
            color: var(--muted);
            font-size: .65rem;
        }

        .comment-stars {
            margin-bottom: 7px;
            color: #f4b400;
            font-size: .75rem;
        }

        .comment-text {
            margin: 0;
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.7;
        }


        /* SORULAR */

        .question-description {
            margin: -7px 0 18px;
            color: var(--muted);
            font-size: .75rem;
            line-height: 1.6;
        }

        .question-textarea {
            width: 100%;
            min-height: 100px;
            padding: 12px;
            resize: vertical;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .78rem;
        }

            .question-textarea:focus {
                border-color: var(--teal);
            }

        .question-submit-btn {
            margin-top: 10px;
            padding: 9px 18px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--navy);
            color: white;
            border: none;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
            transition: .2s;
        }

            .question-submit-btn:hover {
                background: var(--teal);
            }

        .question-item {
            padding: 17px 0;
            border-bottom: 1px solid #eeeae4;
        }

            .question-item:last-child {
                border-bottom: none;
            }

        .question-top {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            color: var(--navy);
        }

            .question-top i {
                margin-top: 2px;
                color: var(--teal);
            }

            .question-top strong {
                font-size: .8rem;
                line-height: 1.6;
            }

        .question-answer {
            margin-top: 12px;
            padding: 13px 15px;
            display: flex;
            gap: 10px;
            background: #f4f9f9;
            border-radius: 11px;
        }

            .question-answer > i {
                margin-top: 2px;
                color: var(--teal);
            }

            .question-answer small {
                display: block;
                margin-bottom: 4px;
                color: var(--teal-dark);
                font-size: .62rem;
                font-weight: 700;
            }

            .question-answer p {
                margin: 0;
                color: var(--navy);
                font-size: .75rem;
                line-height: 1.65;
            }

        .question-date {
            display: block;
            margin-top: 8px;
            color: var(--muted);
            font-size: .62rem;
        }

        .question-login {
            padding: 12px 14px;
            background: #f8f7f4;
            border-radius: 10px;
            color: var(--muted);
            font-size: .75rem;
        }

            .question-login a {
                color: var(--teal);
                font-weight: 600;
            }


        /* GERİ */

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 18px;
            color: var(--muted);
            font-size: .75rem;
        }

            .back-link:hover {
                color: var(--teal);
            }


        /* MESAJ */

        .reservation-message {
            border-radius: 12px;
            font-size: .8rem;
        }


        @@media(max-width: 991px) {

            .detail-cover {
                height: 280px;
            }

            .reservation-card {
                position: static;
            }

            .detail-info-bar {
                flex-wrap: wrap;
                gap: 20px;
            }
        }

    </style>
}


<section class="tour-detail-page">

    <div class="site-container">


        <!-- GERİ -->

        <a asp-controller="Tour"
               asp-action="Index"
               class="back-link">

            <i class="bi bi-arrow-left"></i>

            Turlara Dön

        </a>


        <!-- GENEL MESAJLAR -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success reservation-message">

                @TempData["SuccessMessage"]

            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger reservation-message">

                @TempData["ErrorMessage"]

            </div>
        }


        <!-- BAŞLIK -->

        <div class="detail-category">

            Travelio Turu

        </div>


        <h1 class="detail-title">

            @Model.TourName

        </h1>


        <div class="detail-location">

            <i class="bi bi-geo-alt-fill"></i>

            @Model.City, @Model.Country

        </div>


        <!-- KAPAK -->

        <div class="detail-cover">

            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl"
                     alt="@Model.TourName" />
            }

        </div>


        <!-- BİLGİ BAR -->

        <div class="detail-info-bar">


            <div class="detail-info-item">

                <i class="bi bi-calendar3"></i>

                <div>

                    <small>
                        Süre
                    </small>

                    <strong>
                        @Model.Day Gün / @Model.Night Gece
                    </strong>

                </div>

            </div>


            <div class="detail-info-item">

                <i class="bi bi-geo-alt"></i>

                <div>

                    <small>
                        Destinasyon
                    </small>

                    <strong>
                        @Model.City
                    </strong>

                </div>

            </div>


            <div class="detail-info-item">

                <i class="bi bi-wallet2"></i>

                <div>

                    <small>
                        Başlangıç Fiyatı
                    </small>

                    <strong>
                        @Model.Price.ToString("N0") TL
                    </strong>

                </div>

            </div>


        </div>


        <div class="row g-4">


            <!-- SOL -->

            <div class="col-lg-8">


                <!-- AÇIKLAMA -->

                <div class="detail-box">

                    <h3>
                        Tur Hakkında
                    </h3>

                    <p class="detail-description">

                        @Model.Description

                    </p>

                </div>


                <!-- ÖZELLİKLER -->
                @if (Model.Features != null && Model.Features.Any())
                {
                    <div class="detail-box">

                        <h3>
                            Tur Özellikleri
                        </h3>

                        <div class="feature-list">

                            @foreach (var feature in Model.Features)
                            {
                                <div class="feature-item">

                                    <i class="bi bi-check-circle-fill"></i>

                                    @feature

                                </div>
                            }

                        </div>

                    </div>
                }


                <!-- TARİHLER -->

                <div class="detail-box">

                    <h3>
                        Tur Tarihleri
                    </h3>


                    @if (Model.TourDates != null && Model.TourDates.Any())
                    {
                        @foreach (var date in Model.TourDates.OrderBy(x => x.Date))
                        {
                            <div class="date-item">

                                <div class="date-main">

                                    <i class="bi bi-calendar-event"></i>

                                    @date.Date.ToString("dd MMMM yyyy")

                                </div>


                                <span class="capacity-badge">

                                    @date.Capacity kişilik yer

                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Henüz tur tarihi eklenmemiş.

                        </div>
                    }

                </div>


                <!-- PROGRAM -->

                <div class="detail-box">

                    <h3>
                        Tur Programı
                    </h3>


                    @if (Model.TourPrograms != null && Model.TourPrograms.Any())
                    {
                        @foreach (var program in Model.TourPrograms.OrderBy(x => x.DayNumber))
                        {
                            <div class="program-item">

                                <div class="program-day">

                                    @program.DayNumber

                                </div>


                                <div class="program-content">

                                    <h5>
                                        @program.Title
                                    </h5>

                                    <p>
                                        @program.Description
                                    </p>


                                    <div class="program-meta">


                                        @if (!string.IsNullOrWhiteSpace(program.City))
                                        {
                                            <span>

                                                <i class="bi bi-geo-alt"></i>

                                                @program.City

                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(program.Transport))
                                        {
                                            <span>

                                                <i class="bi bi-bus-front"></i>

                                                @program.Transport

                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(program.Meal))
                                        {
                                            <span>

                                                <i class="bi bi-cup-hot"></i>

                                                @program.Meal

                                            </span>
                                        }


                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Henüz tur programı eklenmemiş.

                        </div>
                    }

                </div>


                <!-- YORUM YAP -->

                <div class="detail-box">

                    <h3>
                        Yorum Yap
                    </h3>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Comment"
                              asp-action="Add"
                              method="post">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="TourId"
                                   value="@Model.Id" />


                            <label class="reservation-label">
                                Puanınız
                            </label>


                            <select name="Rating"
                                    class="comment-rating"
                                    required>

                                <option value="">
                                    Puan seçiniz
                                </option>

                                <option value="5">
                                    5 - Mükemmel
                                </option>

                                <option value="4">
                                    4 - Çok İyi
                                </option>

                                <option value="3">
                                    3 - İyi
                                </option>

                                <option value="2">
                                    2 - Orta
                                </option>

                                <option value="1">
                                    1 - Kötü
                                </option>

                            </select>


                            <label class="reservation-label">
                                Yorumunuz
                            </label>


                            <textarea name="CommentText"
                                      class="comment-textarea"
                                      placeholder="Tur hakkındaki düşüncelerinizi yazın..."
                                      required></textarea>


                            <button type="submit"
                                    class="comment-submit-btn">

                                <i class="bi bi-send"></i>

                                Yorumu Gönder

                            </button>


                        </form>
                    }
                    else
                    {
                        <div class="text-muted small">

                            Yorum yapabilmek için

                            <a asp-controller="Account"
                                   asp-action="Login">

                                giriş yapmalısınız.

                            </a>

                        </div>
                    }

                </div>


                <!-- YORUMLAR -->

                <div class="detail-box">

                    <h3>
                        Yorumlar
                    </h3>


                    @if (comments.Any())
                    {
                        @foreach (var comment in comments)
                        {
                            <div class="comment-item">


                                <div class="comment-top">

                                    <div class="comment-user">

                                        <i class="bi bi-person-circle"></i>

                                        Travelio Kullanıcısı

                                    </div>


                                    <div class="comment-date">

                                        @comment.CreatedDate.ToString("dd.MM.yyyy")

                                    </div>

                                </div>


                                <div class="comment-stars">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= comment.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }

                                </div>


                                <p class="comment-text">

                                    @comment.CommentText

                                </p>


                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Bu tur için henüz yayınlanmış yorum bulunmuyor.

                        </div>
                    }

                </div>



                <!-- SORU SOR -->

                <div class="detail-box">

                    <h3>
                        Bu Tur Hakkında Soru Sor
                    </h3>

                    <p class="question-description">
                        Tur hakkında merak ettiğiniz bir konuyu bize sorabilirsiniz.
                        Cevaplanan sorular bu sayfada yayınlanır.
                    </p>


                    @if (TempData["QuestionSuccess"] != null)
                    {
                        <div class="alert alert-success reservation-message">

                            @TempData["QuestionSuccess"]

                        </div>
                    }


                    @if (TempData["QuestionError"] != null)
                    {
                        <div class="alert alert-danger reservation-message">

                            @TempData["QuestionError"]

                        </div>
                    }


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Question"
                              asp-action="Add"
                              method="post">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="TourId"
                                   value="@Model.Id" />


                            <textarea name="QuestionText"
                                      class="question-textarea"
                                      placeholder="Örneğin: Müze giriş ücretleri tur fiyatına dahil mi?"
                                      required></textarea>


                            <button type="submit"
                                    class="question-submit-btn">

                                <i class="bi bi-send"></i>

                                Soruyu Gönder

                            </button>


                        </form>
                    }
                    else
                    {
                        <div class="question-login">

                            Soru sorabilmek için

                            <a asp-controller="Account"
                                   asp-action="Login">

                                giriş yapmalısınız.

                            </a>

                        </div>
                    }

                </div>



                <!-- SORU VE CEVAPLAR -->

                <div class="detail-box">

                    <h3>
                        Sık Sorulan Sorular
                    </h3>


                    @if (questions.Any())
                    {
                        @foreach (var question in questions)
                        {
                            <div class="question-item">


                                <div class="question-top">

                                    <i class="bi bi-question-circle-fill"></i>

                                    <strong>

                                        @question.QuestionText

                                    </strong>

                                </div>


                                <div class="question-answer">

                                    <i class="bi bi-chat-left-text-fill"></i>


                                    <div>

                                        <small>
                                            TRAVELIO YANITI
                                        </small>


                                        <p>

                                            @question.AnswerText

                                        </p>

                                    </div>


                                </div>


                                <span class="question-date">

                                    @question.QuestionTime.ToString("dd.MM.yyyy")

                                </span>


                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Bu tur hakkında henüz cevaplanmış bir soru bulunmuyor.

                        </div>
                    }

                </div>


            </div>



            <!-- SAĞ -->

            <div class="col-lg-4">

                <div class="reservation-card">


                    <!-- REZERVASYON FORMU -->

                    <form asp-controller="Reservation"
                          asp-action="Create"
                          method="post">


                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="TourId"
                               value="@Model.Id" />


                        <div class="price-label">

                            Kişi başı

                        </div>


                        <div class="detail-price">

                            @Model.Price.ToString("N0") TL

                            <small>
                                / kişi
                            </small>

                        </div>


                        <label class="reservation-label">

                            Tur Tarihi

                        </label>


                        <select name="TourDateId"
                                id="tourDate"
                                class="reservation-control"
                                required>

                            <option value="">
                                Tarih seçiniz
                            </option>


                            @if (Model.TourDates != null)
                            {
                                @foreach (var date in Model.TourDates
                                    .Where(x =>
                                        x.Date >= DateTime.Today &&
                                        x.Capacity > 0)
                                    .OrderBy(x => x.Date))
                                {
                                    <option value="@date.Id">

                                        @date.Date.ToString("dd.MM.yyyy")
                                        - @date.Capacity yer

                                    </option>
                                }
                            }

                        </select>


                        <label class="reservation-label">

                            Yetişkin

                        </label>


                        <select name="AdultCount"
                                id="adultCount"
                                class="reservation-control">

                            <option value="1">1 Yetişkin</option>
                            <option value="2">2 Yetişkin</option>
                            <option value="3">3 Yetişkin</option>
                            <option value="4">4 Yetişkin</option>

                        </select>


                        <label class="reservation-label">

                            Çocuk

                        </label>


                        <select name="ChildCount"
                                id="childCount"
                                class="reservation-control">

                            <option value="0">0 Çocuk</option>
                            <option value="1">1 Çocuk</option>
                            <option value="2">2 Çocuk</option>
                            <option value="3">3 Çocuk</option>

                        </select>


                        <div class="total-price-box">

                            <span>
                                Toplam Tutar
                            </span>

                            <strong id="totalPrice">

                                @Model.Price.ToString("N0") TL

                            </strong>

                        </div>


                        <button type="submit"
                                class="reservation-btn">

                            <i class="bi bi-calendar-check"></i>

                            Rezervasyon Yap

                        </button>


                    </form>



                    <!-- FAVORİ -->

                    <form asp-controller="Favorite"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="tourId"
                               value="@Model.Id" />


                        <button type="submit"
                                class="favorite-add-btn">

                            <i class="bi bi-heart"></i>

                            Favorilere Ekle

                        </button>


                    </form>


                </div>

            </div>


        </div>

    </div>

</section>



@section Scripts {

    <script>

        const adultSelect =
            document.getElementById("adultCount");

        const childSelect =
            document.getElementById("childCount");

        const totalPriceElement =
            document.getElementById("totalPrice");


        const tourPrice =
            Number("@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)");


        function calculateTotal() {

            const adultCount =
                parseInt(adultSelect.value);

            const childCount =
                parseInt(childSelect.value);


            const adultTotal =
                adultCount * tourPrice;

            const childTotal =
                childCount * tourPrice * 0.5;


            const totalPrice =
                adultTotal + childTotal;


            totalPriceElement.innerText =
                totalPrice.toLocaleString("tr-TR") + " TL";
        }


        adultSelect.addEventListener(
            "change",
            calculateTotal
        );


        childSelect.addEventListener(
            "change",
            calculateTotal
        );


        calculateTotal();

    </script>

}