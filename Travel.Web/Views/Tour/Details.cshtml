@model Travel.Web.DTOs.TourDtos.ResultTourDto

@using Travel.Web.DTOs.CommentDtos
@using Travel.Web.DTOs.QuestionDtos
@using System.Globalization

@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";

    var isEnglish =
        CultureInfo.CurrentUICulture.Name.StartsWith("en");

    var tourName =
        isEnglish && !string.IsNullOrWhiteSpace(Model.TourNameEn)
            ? Model.TourNameEn
            : Model.TourName;

    var tourDescription =
        isEnglish && !string.IsNullOrWhiteSpace(Model.DescriptionEn)
            ? Model.DescriptionEn
            : Model.Description;

    ViewData["Title"] = tourName;

    var comments =
        ViewBag.Comments as List<ResultCommentDto>
        ?? new List<ResultCommentDto>();

    var questions =
        ViewBag.Questions as List<ResultQuestionDto>
        ?? new List<ResultQuestionDto>();

    var commentCount = comments.Count;

    var averageRating =
        commentCount > 0
        ? comments.Average(x => x.Rating)
        : 0;

    var roundedAverageRating =
        (int)Math.Round(averageRating);

    var rating5Count = comments.Count(x => x.Rating == 5);
    var rating4Count = comments.Count(x => x.Rating == 4);
    var rating3Count = comments.Count(x => x.Rating == 3);
    var rating2Count = comments.Count(x => x.Rating == 2);
    var rating1Count = comments.Count(x => x.Rating == 1);

    var rating5Percent = commentCount > 0 ? rating5Count * 100 / commentCount : 0;
    var rating4Percent = commentCount > 0 ? rating4Count * 100 / commentCount : 0;
    var rating3Percent = commentCount > 0 ? rating3Count * 100 / commentCount : 0;
    var rating2Percent = commentCount > 0 ? rating2Count * 100 / commentCount : 0;
    var rating1Percent = commentCount > 0 ? rating1Count * 100 / commentCount : 0;

    var galleryImages = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
    {
        galleryImages.Add(Model.CoverImageUrl);
    }

    if (Model.GalleryImages != null)
    {
        foreach (var image in Model.GalleryImages)
        {
            if (!string.IsNullOrWhiteSpace(image) &&
                !galleryImages.Contains(image))
            {
                galleryImages.Add(image);
            }
        }
    }
}

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        .tour-detail-page {
            padding: 35px 0 70px;
        }


        /* ÜST BİLGİ */

        .detail-category {
            color: var(--teal);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .detail-title {
            margin: 5px 0 8px;
            font-size: 2.4rem;
            font-weight: 800;
        }

        .detail-location {
            color: var(--muted);
            font-size: .85rem;
        }

            .detail-location i {
                color: var(--teal);
                margin-right: 4px;
            }


        /* GALERİ SLIDER */

        .tour-gallery {
            margin-top: 22px;
        }

        .gallery-main-wrap {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            background: #e9ecef;
        }

        .gallery-main-image {
            width: 100%;
            height: 390px;
            display: block;
            object-fit: cover;
        }

        .carousel-control-prev,
        .carousel-control-next {
            width: 70px;
        }

        .gallery-arrow {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            background: rgba(14,42,59,.80);
            color: white;
            border-radius: 50%;
            font-size: 1rem;
            backdrop-filter: blur(5px);
            box-shadow: 0 5px 18px rgba(0,0,0,.18);
        }

        .gallery-thumbnails {
            margin-top: 10px;
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .gallery-thumbnail {
            width: 150px;
            height: 82px;
            padding: 0;
            flex-shrink: 0;
            overflow: hidden;
            background: none;
            border: 2px solid transparent;
            border-radius: 11px;
            opacity: .68;
            transition: .2s;
        }

            .gallery-thumbnail img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .gallery-thumbnail:hover,
            .gallery-thumbnail.active {
                opacity: 1;
                border-color: var(--teal);
            }

        .gallery-empty {
            height: 390px;
            margin-top: 22px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            background: #e9ecef;
            color: var(--muted);
        }


        /* GENEL BİLGİ */

        .detail-info-bar {
            margin: 20px 0;
            padding: 16px 20px;
            display: flex;
            gap: 35px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 14px;
        }

        .detail-info-item {
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .detail-info-item i {
                color: var(--teal);
                font-size: 1.2rem;
            }

            .detail-info-item small {
                display: block;
                color: var(--muted);
                font-size: .6rem;
            }

            .detail-info-item strong {
                display: block;
                color: var(--navy);
                font-size: .8rem;
            }


        /* CONTENT */

        .detail-box {
            margin-bottom: 18px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
        }

            .detail-box h3 {
                margin-bottom: 15px;
                font-size: 1.15rem;
                font-weight: 700;
            }

        .detail-description {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            line-height: 1.8;
        }


        /* FEATURES */

        .feature-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .feature-item {
            padding: 7px 11px;
            background: #f4f9f9;
            border-radius: 999px;
            color: var(--navy);
            font-size: .7rem;
            font-weight: 500;
        }

            .feature-item i {
                margin-right: 4px;
                color: var(--teal);
            }


        /* TARİHLER */

        .date-item {
            padding: 12px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eeeae4;
        }

            .date-item:last-child {
                border-bottom: none;
            }

        .date-main {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .8rem;
            font-weight: 600;
        }

            .date-main i {
                color: var(--teal);
            }

        .capacity-badge {
            padding: 5px 9px;
            background: #edf8f7;
            border-radius: 999px;
            color: var(--teal-dark);
            font-size: .65rem;
            font-weight: 600;
        }


        /* PROGRAM ACCORDION */

        .tour-program-accordion .accordion-item {
            margin-bottom: 10px;
            overflow: hidden;
            border: 1px solid #e5e1db;
            border-radius: 12px;
            background: white;
        }

        .tour-program-accordion .accordion-button {
            padding: 15px 16px;
            gap: 12px;
            background: #faf9f7;
            color: var(--navy);
            font-size: .82rem;
            font-weight: 700;
            box-shadow: none;
        }

            .tour-program-accordion .accordion-button:not(.collapsed) {
                background: #f0f8f7;
                color: var(--navy);
            }

            .tour-program-accordion .accordion-button:focus {
                box-shadow: none;
                border-color: transparent;
            }

        .program-day {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: var(--navy);
            color: white;
            border-radius: 50%;
            font-size: .68rem;
            font-weight: 700;
        }

        .program-body {
            padding: 16px;
        }

            .program-body p {
                margin: 0 0 12px;
                color: var(--muted);
                font-size: .75rem;
                line-height: 1.7;
            }

        .program-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            color: var(--muted);
            font-size: .67rem;
        }

            .program-meta span {
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .program-meta i {
                color: var(--teal);
            }


        /* REZERVASYON */

        .reservation-card {
            position: sticky;
            top: 95px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(14,42,59,.08);
        }

        .price-label {
            color: var(--muted);
            font-size: .68rem;
        }

        .detail-price {
            margin-bottom: 18px;
            color: var(--navy);
            font-family: 'Sora';
            font-size: 1.8rem;
            font-weight: 800;
        }

            .detail-price small {
                font-family: 'Inter';
                font-size: .65rem;
                font-weight: 400;
                color: var(--muted);
            }

        .reservation-label {
            display: block;
            margin: 12px 0 5px;
            color: var(--navy);
            font-size: .68rem;
            font-weight: 700;
        }

        .reservation-control {
            width: 100%;
            height: 42px;
            padding: 0 11px;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .75rem;
        }

            .reservation-control:focus {
                border-color: var(--teal);
            }


        /* TOPLAM */

        .total-price-box {
            margin-top: 18px;
            padding: 13px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #e5e1db;
            border-bottom: 1px solid #e5e1db;
        }

            .total-price-box span {
                color: var(--muted);
                font-size: .75rem;
            }

            .total-price-box strong {
                color: var(--navy);
                font-family: 'Sora';
                font-size: 1.15rem;
            }


        /* REZERVASYON BUTONU */

        .reservation-btn {
            width: 100%;
            height: 44px;
            margin-top: 18px;
            border: none;
            border-radius: 999px;
            background: var(--teal);
            color: white;
            font-size: .78rem;
            font-weight: 600;
        }

            .reservation-btn:hover {
                background: var(--teal-dark);
            }


        /* FAVORİ */

        .favorite-add-btn {
            width: 100%;
            height: 44px;
            margin-top: 10px;
            background: white;
            color: var(--navy);
            border: 1px solid #e5e1db;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 600;
            transition: .2s;
        }

            .favorite-add-btn:hover {
                color: var(--teal);
                border-color: var(--teal);
                background: #f4f9f9;
            }


        /* YORUM */

        .comment-rating {
            width: 100%;
            height: 42px;
            padding: 0 10px;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .75rem;
        }

            .comment-rating:focus {
                border-color: var(--teal);
            }

        .comment-textarea {
            width: 100%;
            min-height: 110px;
            padding: 12px;
            resize: vertical;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .78rem;
        }

            .comment-textarea:focus {
                border-color: var(--teal);
            }

        .comment-submit-btn {
            margin-top: 10px;
            padding: 9px 18px;
            background: var(--teal);
            color: white;
            border: none;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
        }

            .comment-submit-btn:hover {
                background: var(--teal-dark);
            }

        .comment-item {
            padding: 16px 0;
            border-bottom: 1px solid #eeeae4;
        }

            .comment-item:last-child {
                border-bottom: none;
            }

        .comment-top {
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .comment-user {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--navy);
            font-size: .75rem;
            font-weight: 600;
        }

            .comment-user i {
                color: var(--teal);
            }

        .comment-date {
            color: var(--muted);
            font-size: .65rem;
        }

        .comment-stars {
            margin-bottom: 7px;
            color: #f4b400;
            font-size: .75rem;
        }

        .comment-text {
            margin: 0;
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.7;
        }


        /* PUAN ÖZETİ */

        .rating-summary {
            display: grid;
            grid-template-columns: 170px 1fr;
            gap: 25px;
            align-items: center;
        }

        .rating-average {
            text-align: center;
            padding: 18px;
            background: #faf9f7;
            border-radius: 14px;
        }

            .rating-average strong {
                display: block;
                color: var(--navy);
                font-family: 'Sora';
                font-size: 2.2rem;
                line-height: 1;
            }

            .rating-average .rating-stars {
                margin: 9px 0 5px;
                color: #f4b400;
                font-size: .82rem;
            }

            .rating-average span {
                color: var(--muted);
                font-size: .65rem;
            }

        .rating-row {
            display: grid;
            grid-template-columns: 42px 1fr 42px;
            gap: 8px;
            align-items: center;
            margin-bottom: 8px;
            font-size: .68rem;
            color: var(--muted);
        }

            .rating-row:last-child {
                margin-bottom: 0;
            }

        .rating-bar {
            height: 7px;
            overflow: hidden;
            background: #ece9e4;
            border-radius: 999px;
        }

        .rating-bar-fill {
            height: 100%;
            background: #f4b400;
            border-radius: 999px;
        }


        /* SORULAR */

        .question-description {
            margin: -7px 0 18px;
            color: var(--muted);
            font-size: .75rem;
            line-height: 1.6;
        }

        .question-textarea {
            width: 100%;
            min-height: 100px;
            padding: 12px;
            resize: vertical;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .78rem;
        }

            .question-textarea:focus {
                border-color: var(--teal);
            }

        .question-submit-btn {
            margin-top: 10px;
            padding: 9px 18px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--navy);
            color: white;
            border: none;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
            transition: .2s;
        }

            .question-submit-btn:hover {
                background: var(--teal);
            }

        .question-item {
            padding: 17px 0;
            border-bottom: 1px solid #eeeae4;
        }

            .question-item:last-child {
                border-bottom: none;
            }

        .question-top {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            color: var(--navy);
        }

            .question-top i {
                margin-top: 2px;
                color: var(--teal);
            }

            .question-top strong {
                font-size: .8rem;
                line-height: 1.6;
            }

        .question-answer {
            margin-top: 12px;
            padding: 13px 15px;
            display: flex;
            gap: 10px;
            background: #f4f9f9;
            border-radius: 11px;
        }

            .question-answer > i {
                margin-top: 2px;
                color: var(--teal);
            }

            .question-answer small {
                display: block;
                margin-bottom: 4px;
                color: var(--teal-dark);
                font-size: .62rem;
                font-weight: 700;
            }

            .question-answer p {
                margin: 0;
                color: var(--navy);
                font-size: .75rem;
                line-height: 1.65;
            }

        .question-date {
            display: block;
            margin-top: 8px;
            color: var(--muted);
            font-size: .62rem;
        }

        .question-login {
            padding: 12px 14px;
            background: #f8f7f4;
            border-radius: 10px;
            color: var(--muted);
            font-size: .75rem;
        }

            .question-login a {
                color: var(--teal);
                font-weight: 600;
            }


        /* GERİ */

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 18px;
            color: var(--muted);
            font-size: .75rem;
        }

            .back-link:hover {
                color: var(--teal);
            }


        /* MESAJ */

        .reservation-message {
            border-radius: 12px;
            font-size: .8rem;
        }


        @@media(max-width: 991px) {

            .gallery-main-image,
            .gallery-empty {
                height: 280px;
            }

            .gallery-thumbnail {
                width: 110px;
                height: 65px;
            }

            .reservation-card {
                position: static;
            }

            .detail-info-bar {
                flex-wrap: wrap;
                gap: 20px;
            }


            .rating-summary {
                grid-template-columns: 1fr;
            }
        }

    </style>
}


<section class="tour-detail-page">

    <div class="site-container">


        <!-- GERİ -->

        <a asp-controller="Tour"
               asp-action="Index"
               class="back-link">

            <i class="bi bi-arrow-left"></i>

            Turlara Dön

        </a>


        <!-- GENEL MESAJLAR -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success reservation-message">

                @TempData["SuccessMessage"]

            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger reservation-message">

                @TempData["ErrorMessage"]

            </div>
        }


        <!-- BAŞLIK -->

        <div class="detail-category">

            Travelio Turu

        </div>


        <h1 class="detail-title">

            @tourName

        </h1>


        <div class="detail-location">

            <i class="bi bi-geo-alt-fill"></i>

            @Model.City, @Model.Country

        </div>


        <!-- GALERİ SLIDER -->
        @if (galleryImages.Any())
        {
            <div class="tour-gallery">

                <div id="tourGalleryCarousel"
                     class="carousel slide"
                     data-bs-ride="false">

                    <div class="carousel-inner gallery-main-wrap">

                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">

                                <img src="@galleryImages[i]"
                                     class="gallery-main-image"
                                     alt="@tourName" />

                            </div>
                        }

                    </div>


                    @if (galleryImages.Count > 1)
                    {
                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#tourGalleryCarousel"
                                data-bs-slide="prev">

                            <span class="gallery-arrow">
                                <i class="bi bi-chevron-left"></i>
                            </span>

                            <span class="visually-hidden">
                                Önceki
                            </span>

                        </button>


                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#tourGalleryCarousel"
                                data-bs-slide="next">

                            <span class="gallery-arrow">
                                <i class="bi bi-chevron-right"></i>
                            </span>

                            <span class="visually-hidden">
                                Sonraki
                            </span>

                        </button>
                    }

                </div>


                @if (galleryImages.Count > 1)
                {
                    <div class="gallery-thumbnails">

                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            <button type="button"
                                    class="gallery-thumbnail @(i == 0 ? "active" : "")"
                                    data-bs-target="#tourGalleryCarousel"
                                    data-bs-slide-to="@i"
                                    aria-label="@(i + 1). görsel">

                                <img src="@galleryImages[i]"
                                     alt="@tourName" />

                            </button>
                        }

                    </div>
                }

            </div>
        }
        else
        {
            <div class="gallery-empty">
                Tur görseli bulunmuyor.
            </div>
        }


        <!-- BİLGİ BAR -->

        <div class="detail-info-bar">


            <div class="detail-info-item">

                <i class="bi bi-calendar3"></i>

                <div>

                    <small>
                        Süre
                    </small>

                    <strong>
                        @Model.Day Gün / @Model.Night Gece
                    </strong>

                </div>

            </div>


            <div class="detail-info-item">

                <i class="bi bi-geo-alt"></i>

                <div>

                    <small>
                        Destinasyon
                    </small>

                    <strong>
                        @Model.City
                    </strong>

                </div>

            </div>


            <div class="detail-info-item">

                <i class="bi bi-wallet2"></i>

                <div>

                    <small>
                        Başlangıç Fiyatı
                    </small>

                    <strong>
                        @Model.Price.ToString("N0") TL
                    </strong>

                </div>

            </div>


            <div class="detail-info-item">

                <i class="bi bi-star-fill"></i>

                <div>

                    <small>
                        Ortalama Puan
                    </small>

                    <strong>
                        @averageRating.ToString("0.0") / 5
                    </strong>

                </div>

            </div>


        </div>


        <div class="row g-4">


            <!-- SOL -->

            <div class="col-lg-8">


                <!-- AÇIKLAMA -->

                <div class="detail-box">

                    <h3>
                        Tur Hakkında
                    </h3>

                    <p class="detail-description">

                        @tourDescription

                    </p>

                </div>


                <!-- ÖZELLİKLER -->
                @if (Model.Features != null && Model.Features.Any())
                {
                    <div class="detail-box">

                        <h3>
                            Tur Özellikleri
                        </h3>

                        <div class="feature-list">

                            @foreach (var feature in Model.Features)
                            {
                                <div class="feature-item">

                                    <i class="bi bi-check-circle-fill"></i>

                                    @feature

                                </div>
                            }

                        </div>

                    </div>
                }


                <!-- TARİHLER -->

                <div class="detail-box">

                    <h3>
                        Tur Tarihleri
                    </h3>


                    @if (Model.TourDates != null && Model.TourDates.Any())
                    {
                        @foreach (var date in Model.TourDates.OrderBy(x => x.Date))
                        {
                            <div class="date-item">

                                <div class="date-main">

                                    <i class="bi bi-calendar-event"></i>

                                    @date.Date.ToString("dd MMMM yyyy")

                                </div>


                                <span class="capacity-badge">

                                    @date.Capacity kişilik yer

                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Henüz tur tarihi eklenmemiş.

                        </div>
                    }

                </div>


                <!-- PROGRAM -->

                <div class="detail-box">

                    <h3>
                        Tur Programı
                    </h3>


                    @if (Model.TourPrograms != null && Model.TourPrograms.Any())
                    {
                        <div class="accordion tour-program-accordion"
                             id="tourProgramAccordion">

                            @foreach (var program in Model.TourPrograms.OrderBy(x => x.DayNumber))
                            {
                                var headingId = $"headingProgram{program.DayNumber}";
                                var collapseId = $"collapseProgram{program.DayNumber}";

                                <div class="accordion-item">

                                    <h2 class="accordion-header"
                                        id="@headingId">

                                        <button class="accordion-button @(program.DayNumber == 1 ? "" : "collapsed")"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@collapseId"
                                                aria-expanded="@(program.DayNumber == 1 ? "true" : "false")"
                                                aria-controls="@collapseId">

                                            <span class="program-day">
                                                @program.DayNumber
                                            </span>

                                            <span>
                                                @program.Title
                                            </span>

                                        </button>

                                    </h2>


                                    <div id="@collapseId"
                                         class="accordion-collapse collapse @(program.DayNumber == 1 ? "show" : "")"
                                         aria-labelledby="@headingId"
                                         data-bs-parent="#tourProgramAccordion">

                                        <div class="program-body">

                                            <p>
                                                @program.Description
                                            </p>


                                            <div class="program-meta">

                                                @if (!string.IsNullOrWhiteSpace(program.City))
                                                {
                                                    <span>

                                                        <i class="bi bi-geo-alt"></i>

                                                        @program.City

                                                    </span>
                                                }


                                                @if (!string.IsNullOrWhiteSpace(program.Transport))
                                                {
                                                    <span>

                                                        <i class="bi bi-bus-front"></i>

                                                        @program.Transport

                                                    </span>
                                                }


                                                @if (!string.IsNullOrWhiteSpace(program.Meal))
                                                {
                                                    <span>

                                                        <i class="bi bi-cup-hot"></i>

                                                        @program.Meal

                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">

                            Henüz tur programı eklenmemiş.

                        </div>
                    }

                </div>



                <!-- PUAN ÖZETİ -->

                <div class="detail-box">

                    <h3>
                        Tur Puanı
                    </h3>


                    <div class="rating-summary">


                        <div class="rating-average">

                            <strong>
                                @averageRating.ToString("0.0")
                            </strong>


                            <div class="rating-stars">

                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= roundedAverageRating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }

                            </div>


                            <span>
                                @commentCount kullanıcı yorumu
                            </span>

                        </div>



                        <div>


                            <div class="rating-row">

                                <span>5 yıldız</span>

                                <div class="rating-bar">
                                    <div class="rating-bar-fill"
                                         style="width:@rating5Percent%"></div>
                                </div>

                                <span>@rating5Percent%</span>

                            </div>


                            <div class="rating-row">

                                <span>4 yıldız</span>

                                <div class="rating-bar">
                                    <div class="rating-bar-fill"
                                         style="width:@rating4Percent%"></div>
                                </div>

                                <span>@rating4Percent%</span>

                            </div>


                            <div class="rating-row">

                                <span>3 yıldız</span>

                                <div class="rating-bar">
                                    <div class="rating-bar-fill"
                                         style="width:@rating3Percent%"></div>
                                </div>

                                <span>@rating3Percent%</span>

                            </div>


                            <div class="rating-row">

                                <span>2 yıldız</span>

                                <div class="rating-bar">
                                    <div class="rating-bar-fill"
                                         style="width:@rating2Percent%"></div>
                                </div>

                                <span>@rating2Percent%</span>

                            </div>


                            <div class="rating-row">

                                <span>1 yıldız</span>

                                <div class="rating-bar">
                                    <div class="rating-bar-fill"
                                         style="width:@rating1Percent%"></div>
                                </div>

                                <span>@rating1Percent%</span>

                            </div>


                        </div>


                    </div>

                </div>



                <!-- YORUM YAP -->

                <div class="detail-box">

                    <h3>
                        Yorum Yap
                    </h3>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Comment"
                              asp-action="Add"
                              method="post">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="TourId"
                                   value="@Model.Id" />


                            <label class="reservation-label">
                                Puanınız
                            </label>


                            <select name="Rating"
                                    class="comment-rating"
                                    required>

                                <option value="">
                                    Puan seçiniz
                                </option>

                                <option value="5">
                                    5 - Mükemmel
                                </option>

                                <option value="4">
                                    4 - Çok İyi
                                </option>

                                <option value="3">
                                    3 - İyi
                                </option>

                                <option value="2">
                                    2 - Orta
                                </option>

                                <option value="1">
                                    1 - Kötü
                                </option>

                            </select>


                            <label class="reservation-label">
                                Yorumunuz
                            </label>


                            <textarea name="CommentText"
                                      class="comment-textarea"
                                      placeholder="Tur hakkındaki düşüncelerinizi yazın..."
                                      required></textarea>


                            <button type="submit"
                                    class="comment-submit-btn">

                                <i class="bi bi-send"></i>

                                Yorumu Gönder

                            </button>


                        </form>
                    }
                    else
                    {
                        <div class="text-muted small">

                            Yorum yapabilmek için

                            <a asp-controller="Account"
                                   asp-action="Login">

                                giriş yapmalısınız.

                            </a>

                        </div>
                    }

                </div>


                <!-- YORUMLAR -->

                <div class="detail-box">

                    <h3>
                        Yorumlar
                    </h3>


                    @if (comments.Any())
                    {
                        @foreach (var comment in comments)
                        {
                            <div class="comment-item">


                                <div class="comment-top">

                                    <div class="comment-user">

                                        <i class="bi bi-person-circle"></i>

                                        Travelio Kullanıcısı

                                    </div>


                                    <div class="comment-date">

                                        @comment.CreatedDate.ToString("dd.MM.yyyy")

                                    </div>

                                </div>


                                <div class="comment-stars">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= comment.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }

                                </div>


                                <p class="comment-text">

                                    @comment.CommentText

                                </p>


                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Bu tur için henüz yayınlanmış yorum bulunmuyor.

                        </div>
                    }

                </div>



                <!-- SORU SOR -->

                <div class="detail-box">

                    <h3>
                        Bu Tur Hakkında Soru Sor
                    </h3>

                    <p class="question-description">
                        Tur hakkında merak ettiğiniz bir konuyu bize sorabilirsiniz.
                        Cevaplanan sorular bu sayfada yayınlanır.
                    </p>


                    @if (TempData["QuestionSuccess"] != null)
                    {
                        <div class="alert alert-success reservation-message">

                            @TempData["QuestionSuccess"]

                        </div>
                    }


                    @if (TempData["QuestionError"] != null)
                    {
                        <div class="alert alert-danger reservation-message">

                            @TempData["QuestionError"]

                        </div>
                    }


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Question"
                              asp-action="Add"
                              method="post">

                            @Html.AntiForgeryToken()


                            <input type="hidden"
                                   name="TourId"
                                   value="@Model.Id" />


                            <textarea name="QuestionText"
                                      class="question-textarea"
                                      placeholder="Örneğin: Müze giriş ücretleri tur fiyatına dahil mi?"
                                      required></textarea>


                            <button type="submit"
                                    class="question-submit-btn">

                                <i class="bi bi-send"></i>

                                Soruyu Gönder

                            </button>


                        </form>
                    }
                    else
                    {
                        <div class="question-login">

                            Soru sorabilmek için

                            <a asp-controller="Account"
                                   asp-action="Login">

                                giriş yapmalısınız.

                            </a>

                        </div>
                    }

                </div>



                <!-- SORU VE CEVAPLAR -->

                <div class="detail-box">

                    <h3>
                        Sık Sorulan Sorular
                    </h3>


                    @if (questions.Any())
                    {
                        @foreach (var question in questions)
                        {
                            <div class="question-item">


                                <div class="question-top">

                                    <i class="bi bi-question-circle-fill"></i>

                                    <strong>

                                        @question.QuestionText

                                    </strong>

                                </div>


                                <div class="question-answer">

                                    <i class="bi bi-chat-left-text-fill"></i>


                                    <div>

                                        <small>
                                            TRAVELIO YANITI
                                        </small>


                                        <p>

                                            @question.AnswerText

                                        </p>

                                    </div>


                                </div>


                                <span class="question-date">

                                    @question.QuestionTime.ToString("dd.MM.yyyy")

                                </span>


                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small">

                            Bu tur hakkında henüz cevaplanmış bir soru bulunmuyor.

                        </div>
                    }

                </div>


            </div>



            <!-- SAĞ -->

            <div class="col-lg-4">

                <div class="reservation-card">


                    <!-- REZERVASYON FORMU -->

                    <form asp-controller="Reservation"
                          asp-action="Create"
                          method="post">


                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="TourId"
                               value="@Model.Id" />


                        <div class="price-label">

                            Kişi başı

                        </div>


                        <div class="detail-price">

                            @Model.Price.ToString("N0") TL

                            <small>
                                / kişi
                            </small>

                        </div>


                        <label class="reservation-label">

                            Tur Tarihi

                        </label>


                        <select name="TourDateId"
                                id="tourDate"
                                class="reservation-control"
                                required>

                            <option value="">
                                Tarih seçiniz
                            </option>


                            @if (Model.TourDates != null)
                            {
                                @foreach (var date in Model.TourDates
                                    .Where(x =>
                                        x.Date >= DateTime.Today &&
                                        x.Capacity > 0)
                                    .OrderBy(x => x.Date))
                                {
                                    <option value="@date.Id">

                                        @date.Date.ToString("dd.MM.yyyy")
                                        - @date.Capacity yer

                                    </option>
                                }
                            }

                        </select>


                        <label class="reservation-label">

                            Yetişkin

                        </label>


                        <select name="AdultCount"
                                id="adultCount"
                                class="reservation-control">

                            <option value="1">1 Yetişkin</option>
                            <option value="2">2 Yetişkin</option>
                            <option value="3">3 Yetişkin</option>
                            <option value="4">4 Yetişkin</option>

                        </select>


                        <label class="reservation-label">

                            Çocuk

                        </label>


                        <select name="ChildCount"
                                id="childCount"
                                class="reservation-control">

                            <option value="0">0 Çocuk</option>
                            <option value="1">1 Çocuk</option>
                            <option value="2">2 Çocuk</option>
                            <option value="3">3 Çocuk</option>

                        </select>


                        <div class="total-price-box">

                            <span>
                                Toplam Tutar
                            </span>

                            <strong id="totalPrice">

                                @Model.Price.ToString("N0") TL

                            </strong>

                        </div>


                        <button type="submit"
                                class="reservation-btn">

                            <i class="bi bi-calendar-check"></i>

                            Rezervasyon Yap

                        </button>


                    </form>



                    <!-- FAVORİ -->

                    <form asp-controller="Favorite"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()


                        <input type="hidden"
                               name="tourId"
                               value="@Model.Id" />


                        <button type="submit"
                                class="favorite-add-btn">

                            <i class="bi bi-heart"></i>

                            Favorilere Ekle

                        </button>


                    </form>


                </div>

            </div>


        </div>

    </div>

</section>



@section Scripts {

    <script>

        const adultSelect =
            document.getElementById("adultCount");

        const childSelect =
            document.getElementById("childCount");

        const totalPriceElement =
            document.getElementById("totalPrice");


        const tourPrice =
            Number("@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)");


        function calculateTotal() {

            const adultCount =
                parseInt(adultSelect.value);

            const childCount =
                parseInt(childSelect.value);


            const adultTotal =
                adultCount * tourPrice;

            const childTotal =
                childCount * tourPrice * 0.5;


            const totalPrice =
                adultTotal + childTotal;


            totalPriceElement.innerText =
                totalPrice.toLocaleString("tr-TR") + " TL";
        }


        adultSelect.addEventListener(
            "change",
            calculateTotal
        );


        childSelect.addEventListener(
            "change",
            calculateTotal
        );


        calculateTotal();


        const galleryCarousel =
            document.getElementById("tourGalleryCarousel");

        const galleryThumbnails =
            document.querySelectorAll(".gallery-thumbnail");


        if (galleryCarousel && galleryThumbnails.length > 0) {

            galleryCarousel.addEventListener(
                "slid.bs.carousel",
                function (event) {

                    galleryThumbnails.forEach(
                        thumbnail =>
                            thumbnail.classList.remove("active")
                    );

                    if (galleryThumbnails[event.to]) {
                        galleryThumbnails[event.to]
                            .classList.add("active");
                    }
                }
            );
        }

    </script>

}


