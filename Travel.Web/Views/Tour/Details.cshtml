@model Travel.Web.DTOs.TourDtos.ResultTourDto

@{
    ViewData["Title"] = Model.TourName;
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        .tour-detail-page {
            padding: 35px 0 70px;
        }

        /* ÜST BİLGİ */

        .detail-category {
            color: var(--teal);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .detail-title {
            margin: 5px 0 8px;
            font-size: 2.4rem;
            font-weight: 800;
        }

        .detail-location {
            color: var(--muted);
            font-size: .85rem;
        }

            .detail-location i {
                color: var(--teal);
                margin-right: 4px;
            }


        /* KAPAK */

        .detail-cover {
            height: 390px;
            margin-top: 22px;
            border-radius: 20px;
            overflow: hidden;
            background: #e9ecef;
        }

            .detail-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }


        /* GENEL BİLGİ */

        .detail-info-bar {
            margin: 20px 0;
            padding: 16px 20px;
            display: flex;
            gap: 35px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 14px;
        }

        .detail-info-item {
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .detail-info-item i {
                color: var(--teal);
                font-size: 1.2rem;
            }

            .detail-info-item small {
                display: block;
                color: var(--muted);
                font-size: .6rem;
            }

            .detail-info-item strong {
                display: block;
                color: var(--navy);
                font-size: .8rem;
            }


        /* CONTENT */

        .detail-box {
            margin-bottom: 18px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
        }

            .detail-box h3 {
                margin-bottom: 15px;
                font-size: 1.15rem;
                font-weight: 700;
            }

        .detail-description {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            line-height: 1.8;
        }


        /* FEATURES */

        .feature-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .feature-item {
            padding: 7px 11px;
            background: #f4f9f9;
            border-radius: 999px;
            color: var(--navy);
            font-size: .7rem;
            font-weight: 500;
        }

            .feature-item i {
                margin-right: 4px;
                color: var(--teal);
            }


        /* TARİHLER */

        .date-item {
            padding: 12px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eeeae4;
        }

            .date-item:last-child {
                border-bottom: none;
            }

        .date-main {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .8rem;
            font-weight: 600;
        }

            .date-main i {
                color: var(--teal);
            }

        .capacity-badge {
            padding: 5px 9px;
            background: #edf8f7;
            border-radius: 999px;
            color: var(--teal-dark);
            font-size: .65rem;
            font-weight: 600;
        }


        /* PROGRAM */

        .program-item {
            display: flex;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #eeeae4;
        }

            .program-item:last-child {
                border-bottom: none;
            }

        .program-day {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: var(--navy);
            color: white;
            border-radius: 50%;
            font-size: .7rem;
            font-weight: 700;
        }

        .program-content h5 {
            margin: 0 0 4px;
            font-size: .85rem;
            font-weight: 700;
        }

        .program-content p {
            margin: 0 0 7px;
            color: var(--muted);
            font-size: .72rem;
            line-height: 1.6;
        }

        .program-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            color: var(--muted);
            font-size: .65rem;
        }

            .program-meta i {
                color: var(--teal);
            }


        /* REZERVASYON KARTI */

        .reservation-card {
            position: sticky;
            top: 95px;
            padding: 22px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(14,42,59,.08);
        }

        .price-label {
            color: var(--muted);
            font-size: .68rem;
        }

        .detail-price {
            margin-bottom: 18px;
            color: var(--navy);
            font-family: 'Sora';
            font-size: 1.8rem;
            font-weight: 800;
        }

            .detail-price small {
                font-family: 'Inter';
                font-size: .65rem;
                font-weight: 400;
                color: var(--muted);
            }

        .reservation-label {
            display: block;
            margin: 12px 0 5px;
            color: var(--navy);
            font-size: .68rem;
            font-weight: 700;
        }

        .reservation-control {
            width: 100%;
            height: 42px;
            padding: 0 11px;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 9px;
            outline: none;
            color: var(--navy);
            font-size: .75rem;
        }

            .reservation-control:focus {
                border-color: var(--teal);
            }


        /* TOPLAM FİYAT */

        .total-price-box {
            margin-top: 18px;
            padding: 13px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #e5e1db;
            border-bottom: 1px solid #e5e1db;
        }

            .total-price-box span {
                color: var(--muted);
                font-size: .75rem;
            }

            .total-price-box strong {
                color: var(--navy);
                font-family: 'Sora';
                font-size: 1.15rem;
            }


        /* REZERVASYON BUTONU */

        .reservation-btn {
            width: 100%;
            height: 44px;
            margin-top: 18px;
            border: none;
            border-radius: 999px;
            background: var(--teal);
            color: white;
            font-size: .78rem;
            font-weight: 600;
        }

            .reservation-btn:hover {
                background: var(--teal-dark);
            }


        /* GERİ */

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 18px;
            color: var(--muted);
            font-size: .75rem;
        }

            .back-link:hover {
                color: var(--teal);
            }


        @@media(max-width: 991px) {

            .detail-cover {
                height: 280px;
            }

            .reservation-card {
                position: static;
            }

            .detail-info-bar {
                flex-wrap: wrap;
                gap: 20px;
            }
        }

    </style>
}


<section class="tour-detail-page">

    <div class="site-container">


        <!-- GERİ -->

        <a asp-controller="Tour"
               asp-action="Index"
               class="back-link">

            <i class="bi bi-arrow-left"></i>

            Turlara Dön

        </a>



        <!-- BAŞLIK -->

        <div class="detail-category">
            Travelio Turu
        </div>

        <h1 class="detail-title">
            @Model.TourName
        </h1>

        <div class="detail-location">

            <i class="bi bi-geo-alt-fill"></i>

            @Model.City, @Model.Country

        </div>



        <!-- KAPAK -->

        <div class="detail-cover">

            @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl"
                     alt="@Model.TourName" />
            }

        </div>



        <!-- BİLGİ BAR -->

        <div class="detail-info-bar">


            <div class="detail-info-item">

                <i class="bi bi-calendar3"></i>

                <div>

                    <small>
                        Süre
                    </small>

                    <strong>
                        @Model.Day Gün / @Model.Night Gece
                    </strong>

                </div>

            </div>



            <div class="detail-info-item">

                <i class="bi bi-geo-alt"></i>

                <div>

                    <small>
                        Destinasyon
                    </small>

                    <strong>
                        @Model.City
                    </strong>

                </div>

            </div>



            <div class="detail-info-item">

                <i class="bi bi-wallet2"></i>

                <div>

                    <small>
                        Başlangıç Fiyatı
                    </small>

                    <strong>
                        @Model.Price.ToString("N0") TL
                    </strong>

                </div>

            </div>


        </div>



        <div class="row g-4">


            <!-- SOL TARAF -->

            <div class="col-lg-8">


                <!-- AÇIKLAMA -->

                <div class="detail-box">

                    <h3>
                        Tur Hakkında
                    </h3>

                    <p class="detail-description">

                        @Model.Description

                    </p>

                </div>



                <!-- ÖZELLİKLER -->
                @if (Model.Features != null && Model.Features.Any())
                {

                    <div class="detail-box">

                        <h3>
                            Tur Özellikleri
                        </h3>


                        <div class="feature-list">


                            @foreach (var feature in Model.Features)
                            {

                                <div class="feature-item">

                                    <i class="bi bi-check-circle-fill"></i>

                                    @feature

                                </div>

                            }


                        </div>

                    </div>

                }



                <!-- TARİHLER -->

                <div class="detail-box">

                    <h3>
                        Tur Tarihleri
                    </h3>


                    @if (Model.TourDates != null && Model.TourDates.Any())
                    {

                        @foreach (var date in Model.TourDates.OrderBy(x => x.Date))
                        {

                            <div class="date-item">


                                <div class="date-main">

                                    <i class="bi bi-calendar-event"></i>

                                    @date.Date.ToString("dd MMMM yyyy")

                                </div>


                                <span class="capacity-badge">

                                    @date.Capacity kişilik yer

                                </span>


                            </div>

                        }

                    }
                    else
                    {

                        <div class="text-muted small">

                            Henüz tur tarihi eklenmemiş.

                        </div>

                    }

                </div>



                <!-- PROGRAM -->

                <div class="detail-box">

                    <h3>
                        Tur Programı
                    </h3>


                    @if (Model.TourPrograms != null && Model.TourPrograms.Any())
                    {

                        @foreach (var program in Model.TourPrograms.OrderBy(x => x.DayNumber))
                        {

                            <div class="program-item">


                                <div class="program-day">

                                    @program.DayNumber

                                </div>


                                <div class="program-content">


                                    <h5>
                                        @program.Title
                                    </h5>


                                    <p>
                                        @program.Description
                                    </p>


                                    <div class="program-meta">


                                        @if (!string.IsNullOrWhiteSpace(program.City))
                                        {

                                            <span>

                                                <i class="bi bi-geo-alt"></i>

                                                @program.City

                                            </span>

                                        }


                                        @if (!string.IsNullOrWhiteSpace(program.Transport))
                                        {

                                            <span>

                                                <i class="bi bi-bus-front"></i>

                                                @program.Transport

                                            </span>

                                        }


                                        @if (!string.IsNullOrWhiteSpace(program.Meal))
                                        {

                                            <span>

                                                <i class="bi bi-cup-hot"></i>

                                                @program.Meal

                                            </span>

                                        }


                                    </div>


                                </div>


                            </div>

                        }

                    }
                    else
                    {

                        <div class="text-muted small">

                            Henüz tur programı eklenmemiş.

                        </div>

                    }

                </div>


            </div>



            <!-- SAĞ TARAF -->

            <div class="col-lg-4">


                <div class="reservation-card">


                    <!-- KİŞİ BAŞI FİYAT -->

                    <div class="price-label">

                        Kişi başı

                    </div>


                    <div class="detail-price">

                        @Model.Price.ToString("N0") TL

                        <small>
                            / kişi
                        </small>

                    </div>



                    <!-- TARİH -->

                    <label class="reservation-label">

                        Tur Tarihi

                    </label>


                    <select id="tourDate"
                            class="reservation-control">


                        <option value="">

                            Tarih seçiniz

                        </option>


                        @if (Model.TourDates != null)
                        {

                            @foreach (var date in Model.TourDates
                                .Where(x =>
                                    x.Date >= DateTime.Today &&
                                    x.Capacity > 0)
                                .OrderBy(x => x.Date))
                            {

                                <option value="@date.Id">

                                    @date.Date.ToString("dd.MM.yyyy")
                                    - @date.Capacity yer

                                </option>

                            }

                        }


                    </select>



                    <!-- YETİŞKİN -->

                    <label class="reservation-label">

                        Yetişkin

                    </label>


                    <select id="adultCount"
                            class="reservation-control">

                        <option value="1">
                            1 Yetişkin
                        </option>

                        <option value="2">
                            2 Yetişkin
                        </option>

                        <option value="3">
                            3 Yetişkin
                        </option>

                        <option value="4">
                            4 Yetişkin
                        </option>

                    </select>



                    <!-- ÇOCUK -->

                    <label class="reservation-label">

                        Çocuk

                    </label>


                    <select id="childCount"
                            class="reservation-control">

                        <option value="0">
                            0 Çocuk
                        </option>

                        <option value="1">
                            1 Çocuk
                        </option>

                        <option value="2">
                            2 Çocuk
                        </option>

                        <option value="3">
                            3 Çocuk
                        </option>

                    </select>



                    <!-- TOPLAM FİYAT -->

                    <div class="total-price-box">

                        <span>
                            Toplam Tutar
                        </span>

                        <strong id="totalPrice">

                            @Model.Price.ToString("N0") TL

                        </strong>

                    </div>



                    <!-- BUTTON -->

                    <button type="button"
                            class="reservation-btn">

                        <i class="bi bi-calendar-check"></i>

                        Rezervasyon Yap

                    </button>


                </div>


            </div>


        </div>


    </div>

</section>



@section Scripts {

    <script>

        const adultSelect =
            document.getElementById("adultCount");

        const childSelect =
            document.getElementById("childCount");

        const totalPriceElement =
            document.getElementById("totalPrice");


        const tourPrice =
            Number("@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)");


        function calculateTotal() {

            const adultCount =
                parseInt(adultSelect.value);

            const childCount =
                parseInt(childSelect.value);


            // Yetişkin tam fiyat
            const adultTotal =
                adultCount * tourPrice;


            // Çocuk %50 fiyat
            const childTotal =
                childCount * tourPrice * 0.5;


            const totalPrice =
                adultTotal + childTotal;


            totalPriceElement.innerText =
                totalPrice.toLocaleString("tr-TR") + " TL";

        }


        adultSelect.addEventListener(
            "change",
            calculateTotal
        );


        childSelect.addEventListener(
            "change",
            calculateTotal
        );


        calculateTotal();

    </script>

}