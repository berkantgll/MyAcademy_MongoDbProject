@model List<Travel.Web.DTOs.DestinationDtos.ResultDestinationDto>

@{
    ViewData["Title"] = "Destinasyonlar";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        .destination-page {
            padding: 50px 0 80px;
        }

        .destination-header {
            max-width: 650px;
            margin-bottom: 35px;
        }

            .destination-header small {
                color: var(--teal);
                font-size: .7rem;
                font-weight: 700;
                letter-spacing: .12em;
            }

            .destination-header h1 {
                margin: 6px 0 8px;
                color: var(--navy);
                font-size: 2.2rem;
                font-weight: 800;
            }

            .destination-header p {
                margin: 0;
                color: var(--muted);
                font-size: .85rem;
            }


        .destination-card {
            height: 100%;
            padding: 24px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
            box-shadow: 0 6px 18px rgba(14,42,59,.05);
            transition: .2s;
        }

            .destination-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 26px rgba(14,42,59,.10);
            }


        .destination-icon {
            width: 48px;
            height: 48px;
            margin-bottom: 18px;
            display: grid;
            place-items: center;
            background: #edf8f7;
            color: var(--teal);
            border-radius: 14px;
            font-size: 1.3rem;
        }


        .destination-card h3 {
            margin-bottom: 6px;
            color: var(--navy);
            font-size: 1.05rem;
            font-weight: 700;
        }


        .destination-location {
            margin-bottom: 20px;
            color: var(--muted);
            font-size: .75rem;
        }

            .destination-location i {
                margin-right: 4px;
                color: var(--teal);
            }


        .destination-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 8px 13px;
            background: var(--navy);
            color: white;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 600;
        }

            .destination-btn:hover {
                background: var(--teal);
                color: white;
            }


        .empty-destination {
            padding: 60px 20px;
            text-align: center;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
        }

    </style>
}


<section class="destination-page">

    <div class="site-container">


        <div class="destination-header">

            <small>
                ROTALARI KEŞFET
            </small>

            <h1>
                Destinasyonlar
            </h1>

            <p>
                Travelio ile keşfedebileceğiniz şehirleri ve rotaları inceleyin.
            </p>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var destination in Model)
                {
                    <div class="col-md-6 col-lg-4">


                        <div class="destination-card">


                            <div class="destination-icon">

                                <i class="bi bi-geo-alt-fill"></i>

                            </div>


                            <h3>

                                @destination.DestinationName

                            </h3>


                            <div class="destination-location">

                                <i class="bi bi-map"></i>

                                @destination.City, @destination.Country

                            </div>


                            <a asp-controller="Tour"
                                   asp-action="Index"
                                   asp-route-destination="@destination.DestinationName"
                                   class="destination-btn">

                                Turları Gör

                                <i class="bi bi-arrow-right"></i>

                            </a>


                        </div>


                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-destination">

                Henüz destinasyon bulunmuyor.

            </div>
        }


    </div>

</section>