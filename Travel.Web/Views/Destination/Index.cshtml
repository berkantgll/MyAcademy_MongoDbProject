@model List<Travel.Web.DTOs.DestinationDtos.ResultDestinationDto>

@{
    ViewData["Title"] = "Destinasyonlar";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";

    var destinationImages =
        ViewBag.DestinationImages
        as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        .destination-page {
            padding: 50px 0 70px;
        }


        /* HEADER */

        .destination-header {
            max-width: 650px;
            margin-bottom: 30px;
        }

            .destination-header small {
                color: var(--teal);
                font-size: .7rem;
                font-weight: 700;
                letter-spacing: .12em;
            }

            .destination-header h1 {
                margin: 6px 0 8px;
                color: var(--navy);
                font-size: 2.2rem;
                font-weight: 800;
            }

            .destination-header p {
                margin: 0;
                color: var(--muted);
                font-size: .85rem;
            }


        /* CARD */

        .destination-card {
            height: 100%;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 17px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(14,42,59,.05);
            transition: .25s;
        }

            .destination-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 14px 30px rgba(14,42,59,.11);
            }


        /* IMAGE */

        .destination-image {
            height: 175px;
            position: relative;
            overflow: hidden;
            background: #e9ecef;
        }

            .destination-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: .35s;
            }

        .destination-card:hover .destination-image img {
            transform: scale(1.04);
        }


        .destination-image-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( to top, rgba(7,35,54,.25), transparent 55% );
        }


        /* BODY */

        .destination-body {
            padding: 18px 20px 20px;
        }


        .destination-card h3 {
            margin: 0 0 6px;
            color: var(--navy);
            font-size: 1rem;
            font-weight: 700;
        }


        .destination-location {
            margin-bottom: 17px;
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--muted);
            font-size: .72rem;
        }

            .destination-location i {
                color: var(--teal);
            }


        /* BUTTON */

        .destination-btn {
            padding: 8px 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--navy);
            color: white;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 600;
            transition: .2s;
        }

            .destination-btn:hover {
                background: var(--teal);
                color: white;
            }


        .empty-destination {
            padding: 60px 20px;
            text-align: center;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
            color: var(--muted);
        }


        @@media(max-width: 768px) {

            .destination-image {
                height: 200px;
            }
        }

    </style>
}


<section class="destination-page">

    <div class="site-container">


        <!-- HEADER -->

        <div class="destination-header">

            <small>
                ROTALARI KEŞFET
            </small>

            <h1>
                Destinasyonlar
            </h1>

            <p>
                Travelio ile keşfedebileceğiniz şehirleri ve rotaları inceleyin.
            </p>

        </div>



        @if (Model != null && Model.Any())
        {

            <div class="row g-4">


                @foreach (var destination in Model)
                {
                    var imageUrl =
                        destinationImages.ContainsKey(destination.Id)
                        ? destinationImages[destination.Id]
                        : "/images/travelio-hero.png";


                    <div class="col-md-6 col-lg-4">


                        <div class="destination-card">


                            <!-- IMAGE -->

                            <div class="destination-image">

                                <img src="@imageUrl"
                                     alt="@destination.DestinationName" />

                                <div class="destination-image-overlay"></div>

                            </div>



                            <!-- BODY -->

                            <div class="destination-body">


                                <h3>

                                    @destination.DestinationName

                                </h3>


                                <div class="destination-location">

                                    <i class="bi bi-geo-alt-fill"></i>

                                    @destination.City, @destination.Country

                                </div>



                                <a asp-controller="Tour"
                                       asp-action="Index"
                                       asp-route-destination="@destination.DestinationName"
                                       class="destination-btn">

                                    Turları Gör

                                    <i class="bi bi-arrow-right"></i>

                                </a>


                            </div>


                        </div>


                    </div>
                }


            </div>

        }
        else
        {

            <div class="empty-destination">

                Henüz destinasyon bulunmuyor.

            </div>

        }


    </div>

</section>