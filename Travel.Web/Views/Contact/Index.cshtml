@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

@section Styles {

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        .contact-page {
            padding: 55px 0 80px;
        }

        .contact-header {
            max-width: 700px;
            margin-bottom: 35px;
        }

            .contact-header small {
                color: var(--teal);
                font-size: .68rem;
                font-weight: 700;
                letter-spacing: .14em;
            }

            .contact-header h1 {
                margin: 6px 0 10px;
                color: var(--navy);
                font-size: 2.3rem;
                font-weight: 800;
            }

            .contact-header p {
                margin: 0;
                color: var(--muted);
                font-size: .85rem;
                line-height: 1.8;
            }


        /* BİLGİ KARTLARI */

        .contact-info-card {
            height: 100%;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 16px;
            box-shadow: 0 6px 18px rgba(14,42,59,.04);
        }

        .contact-info-icon {
            width: 46px;
            height: 46px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            background: #edf8f7;
            color: var(--teal);
            border-radius: 13px;
            font-size: 1.15rem;
        }

        .contact-info-card small {
            display: block;
            margin-bottom: 3px;
            color: var(--muted);
            font-size: .62rem;
        }

        .contact-info-card strong {
            color: var(--navy);
            font-size: .78rem;
            font-weight: 700;
        }


        /* ANA ALAN */

        .contact-main {
            margin-top: 30px;
        }


        /* FORM */

        .contact-form-box {
            height: 100%;
            padding: 30px;
            background: white;
            border: 1px solid #e5e1db;
            border-radius: 20px;
            box-shadow: 0 8px 24px rgba(14,42,59,.05);
        }

        .contact-form-small {
            color: var(--teal);
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .12em;
        }

        .contact-form-box h2 {
            margin: 6px 0 7px;
            color: var(--navy);
            font-size: 1.45rem;
            font-weight: 800;
        }

        .contact-form-description {
            margin-bottom: 24px;
            color: var(--muted);
            font-size: .78rem;
            line-height: 1.7;
        }

        .contact-label {
            display: block;
            margin-bottom: 6px;
            color: var(--navy);
            font-size: .68rem;
            font-weight: 600;
        }

        .contact-control {
            width: 100%;
            padding: 11px 13px;
            background: #faf9f7;
            border: 1px solid #e5e1db;
            border-radius: 10px;
            color: var(--navy);
            font-size: .78rem;
            outline: none;
            transition: .2s;
        }

            .contact-control:focus {
                background: white;
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(20,180,180,.08);
            }

        textarea.contact-control {
            min-height: 145px;
            resize: vertical;
        }

        .contact-submit-btn {
            margin-top: 4px;
            padding: 10px 18px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--navy);
            color: white;
            border: none;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 600;
            transition: .2s;
        }

            .contact-submit-btn:hover {
                background: var(--teal);
            }


        /* HARİTA */

        .contact-map {
            height: 100%;
            min-height: 540px;
            position: relative;
            overflow: hidden;
            background: #e9ecef;
            border: 1px solid #e5e1db;
            border-radius: 20px;
            box-shadow: 0 8px 24px rgba(14,42,59,.05);
        }

            .contact-map iframe {
                width: 100%;
                height: 100%;
                min-height: 540px;
                border: 0;
            }

        .map-card {
            position: absolute;
            left: 20px;
            bottom: 20px;
            padding: 14px 17px;
            background: rgba(255,255,255,.96);
            border-radius: 13px;
            box-shadow: 0 10px 28px rgba(0,0,0,.13);
        }

            .map-card strong {
                display: block;
                margin-bottom: 2px;
                color: var(--navy);
                font-size: .75rem;
            }

            .map-card span {
                color: var(--muted);
                font-size: .64rem;
            }


        @@media(max-width: 991px) {

            .contact-map,
            .contact-map iframe {
                min-height: 360px;
            }
        }

    </style>
}


<section class="contact-page">

    <div class="site-container">


        <!-- BAŞLIK -->

        <div class="contact-header">

            <small>
                BİZE ULAŞIN
            </small>

            <h1>
                İletişim
            </h1>

            <p>
                Tur seçenekleri, rezervasyon süreci veya merak ettiğiniz
                diğer konular hakkında bizimle iletişime geçebilirsiniz.
            </p>

        </div>



        <!-- İLETİŞİM BİLGİLERİ -->

        <div class="row g-3">


            <div class="col-md-4">

                <div class="contact-info-card">

                    <div class="contact-info-icon">

                        <i class="bi bi-envelope"></i>

                    </div>


                    <div>

                        <small>
                            E-posta
                        </small>

                        <strong>
                            info@travelio.com
                        </strong>

                    </div>


                </div>

            </div>



            <div class="col-md-4">

                <div class="contact-info-card">

                    <div class="contact-info-icon">

                        <i class="bi bi-telephone"></i>

                    </div>


                    <div>

                        <small>
                            Telefon
                        </small>

                        <strong>
                            +90 212 000 00 00
                        </strong>

                    </div>


                </div>

            </div>



            <div class="col-md-4">

                <div class="contact-info-card">

                    <div class="contact-info-icon">

                        <i class="bi bi-geo-alt"></i>

                    </div>


                    <div>

                        <small>
                            Merkez Ofis
                        </small>

                        <strong>
                            İstanbul, Türkiye
                        </strong>

                    </div>


                </div>

            </div>


        </div>



        <!-- FORM + HARİTA -->

        <div class="row g-4 contact-main">


            <!-- FORM -->

            <div class="col-lg-6">

                <div class="contact-form-box">


                    <div class="contact-form-small">
                        MESAJ GÖNDER
                    </div>


                    <h2>
                        Size Nasıl Yardımcı Olabiliriz?
                    </h2>


                    <p class="contact-form-description">

                        Formu doldurarak bizimle iletişime geçebilirsiniz.
                        Mesajınız ilgili ekibe iletilecektir.

                    </p>



                    <form>


                        <div class="row g-3">


                            <div class="col-md-6">

                                <label class="contact-label">
                                    Ad Soyad
                                </label>

                                <input type="text"
                                       class="contact-control"
                                       placeholder="Adınız soyadınız" />

                            </div>



                            <div class="col-md-6">

                                <label class="contact-label">
                                    E-posta
                                </label>

                                <input type="email"
                                       class="contact-control"
                                       placeholder="ornek@mail.com" />

                            </div>



                            <div class="col-12">

                                <label class="contact-label">
                                    Konu
                                </label>

                                <input type="text"
                                       class="contact-control"
                                       placeholder="Mesajınızın konusu" />

                            </div>



                            <div class="col-12">

                                <label class="contact-label">
                                    Mesajınız
                                </label>

                                <textarea class="contact-control"
                                          placeholder="Mesajınızı buraya yazabilirsiniz..."></textarea>

                            </div>



                            <div class="col-12">

                                <button type="button"
                                        class="contact-submit-btn">

                                    Mesajı Gönder

                                    <i class="bi bi-send"></i>

                                </button>

                            </div>


                        </div>


                    </form>


                </div>

            </div>



            <!-- HARİTA -->

            <div class="col-lg-6">

                <div class="contact-map">


                    <iframe src="https://www.openstreetmap.org/export/embed.html?bbox=28.80%2C40.90%2C29.20%2C41.15&amp;layer=mapnik"
                            loading="lazy">
                    </iframe>


                    <div class="map-card">

                        <strong>
                            Travelio İstanbul
                        </strong>

                        <span>
                            İstanbul, Türkiye
                        </span>

                    </div>


                </div>

            </div>


        </div>


    </div>

</section>