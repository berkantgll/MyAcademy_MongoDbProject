<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Travelio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

            :root {
                --navy: #0e2a3b;
                --teal: #0fa3a3;
                --teal-dark: #0b7f80;
                --cream: #f7f5f0;
                --white: #ffffff;
                --muted: #647986;
                --line: #e8e4dc;
            }


            * {
                box-sizing: border-box;
            }


            html,
            body {
                min-height: 100%;
                margin: 0;
                padding: 0;
            }


            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                margin-bottom: 0 !important;
                background: var(--cream);
                color: var(--navy);
                font-family: 'Inter', sans-serif;
            }


            main {
                flex: 1;
            }


            a {
                text-decoration: none;
            }


            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                font-family: 'Sora', sans-serif;
            }


            .site-container {
                width: 100%;
                max-width: 1450px;
                margin: auto;
                padding-left: 25px;
                padding-right: 25px;
            }


            .btn-teal {
                padding: 10px 20px;
                background: var(--teal);
                color: white;
                border: none;
                border-radius: 999px;
                font-size: .85rem;
                font-weight: 600;
                transition: .2s;
            }


                .btn-teal:hover {
                    background: var(--teal-dark);
                    color: white;
                }


            .site-footer {
                margin-top: auto;
            }


            @@media(max-width:768px) {

                .site-container {
                    padding-left: 16px;
                    padding-right: 16px;
                }
            }

    </style>

    @RenderSection("Styles", required: false)

</head>


<body>


    <!-- NAVBAR -->
    @await Html.PartialAsync("_SiteNavbar")



    <!-- SAYFA İÇERİĞİ -->

    <main>

        @RenderBody()

    </main>



    <!-- FOOTER -->
    @await Html.PartialAsync("_SiteFooter")



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @RenderSection("Scripts", required: false)


</body>

</html>