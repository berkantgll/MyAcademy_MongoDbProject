@using Travel.Web.DTOs.DestinationDtos
@model UpdateDestinationDto

@{
    ViewData["Title"] = "Destinasyon Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .content {
        padding: 1.8rem;
        max-width: 1100px;
    }

    .page-title {
        font-family: 'Sora';
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--navy);
    }

    .page-text {
        color: var(--muted);
        font-size: .9rem;
    }

    .form-card {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem;
        margin-top: 1.5rem;
    }

    .field {
        margin-bottom: 1rem;
    }

        .field label {
            display: block;
            color: var(--navy);
            font-size: .8rem;
            font-weight: 600;
            margin-bottom: .35rem;
        }

    .ctrl {
        width: 100%;
        border: 1px solid var(--line);
        background: var(--cream);
        border-radius: 11px;
        padding: .7rem .9rem;
        outline: none;
    }

        .ctrl:focus {
            border-color: var(--teal);
            background: #fff;
        }

    .btn-teal {
        background: var(--teal);
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: .7rem 1.2rem;
        font-weight: 600;
    }

    .btn-ghost {
        background: #fff;
        border: 1px solid var(--line);
        color: var(--navy);
        border-radius: 999px;
        padding: .7rem 1.2rem;
        font-weight: 600;
        text-decoration: none;
    }

</style>


<div class="content">

    <h1 class="page-title">
        Destinasyon Güncelle
    </h1>

    <p class="page-text">
        Seçili destinasyonun bilgilerini düzenleyin.
    </p>


    <div class="form-card">

        <form asp-area="Admin"
              asp-controller="Destination"
              asp-action="Update"
              method="post">

            <input type="hidden"
                   asp-for="Id" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="field">

                <label>
                    Destinasyon Adı
                </label>

                <input asp-for="DestinationName"
                       class="ctrl" />

                <span asp-validation-for="DestinationName"
                      class="text-danger">
                </span>

            </div>


            <div class="row">

                <div class="col-md-6 field">

                    <label>
                        Ülke
                    </label>

                    <input asp-for="Country"
                           class="ctrl" />

                    <span asp-validation-for="Country"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 field">

                    <label>
                        Şehir
                    </label>

                    <input asp-for="City"
                           class="ctrl" />

                    <span asp-validation-for="City"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="d-flex justify-content-end gap-2 mt-4">

                <a asp-area="Admin"
                       asp-controller="Destination"
                       asp-action="Index"
                       class="btn-ghost">

                    İptal

                </a>


                <button type="submit"
                        class="btn-teal">

                    Değişiklikleri Kaydet

                </button>

            </div>

        </form>

    </div>

</div>