@model List<Travel.Web.DTOs.CommentDtos.ResultCommentDto>

@{
    ViewData["Title"] = "Yorum Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">
                Yorum Yönetimi
            </h3>

            <p class="text-muted mb-0">
                Kullanıcı yorumlarını buradan yönetebilirsiniz.
            </p>
        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Yorum
                                </th>

                                <th>
                                    Puan
                                </th>

                                <th>
                                    Tarih
                                </th>

                                <th>
                                    Durum
                                </th>

                                <th>
                                    İşlem
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        <div style="max-width: 400px;">

                                            @item.CommentText

                                        </div>

                                    </td>


                                    <td>

                                        @item.Rating / 5

                                    </td>


                                    <td>

                                        @item.CreatedDate.ToString("dd.MM.yyyy")

                                    </td>


                                    <td>

                                        @if (item.IsApproved)
                                        {
                                            <span class="badge bg-success">

                                                Onaylandı

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                Bekliyor

                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="d-flex gap-2">


                                            @if (!item.IsApproved)
                                            {
                                                <a asp-area="Admin"
                                                       asp-controller="Comment"
                                                       asp-action="Approve"
                                                       asp-route-id="@item.Id"
                                                       class="btn btn-sm btn-success">

                                                    Onayla

                                                </a>
                                            }


                                            <a asp-area="Admin"
                                                   asp-controller="Comment"
                                                   asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-danger"
                                                   onclick="return confirm('Yorumu silmek istediğinize emin misiniz?')">

                                                Sil

                                            </a>


                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>
                        Henüz yorum bulunmuyor
                    </h5>

                    <p class="text-muted mb-0">
                        Kullanıcı yorumları burada listelenecek.
                    </p>

                </div>
            }

        </div>

    </div>

</div>