@using Travel.Web.Areas.Admin.Models
@using System.Globalization
@using System.Text.Json
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var trCulture = CultureInfo.GetCultureInfo("tr-TR");
}

<style>

    .content {
        padding: 1.8rem;
        flex: 1;
        max-width: 1500px;
    }

    .eyebrow {
        font-family: 'Sora', sans-serif;
        text-transform: uppercase;
        letter-spacing: .2em;
        font-size: .7rem;
        font-weight: 700;
        color: var(--teal-dark);
    }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .3rem 0;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
        }

    .date-pill {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .5rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        color: var(--navy);
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

    .card-x {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.2rem 1.3rem .2rem;
    }

        .card-head h3 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--navy);
            margin: 0;
        }

    .card-body {
        padding: 1.3rem;
    }

    /* KPI */

    .kpi {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1.25rem 1.3rem;
        height: 100%;
    }

        .kpi .top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: .9rem;
        }

        .kpi .ic {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
        }

            .kpi .ic.warn {
                background: rgba(169,116,26,.12);
                color: #a9741a;
            }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.8rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .85rem;
            color: var(--muted);
            margin-top: .3rem;
        }

        .kpi .sub {
            font-size: .78rem;
            color: var(--muted);
            margin-top: .55rem;
        }

            .kpi .sub .up {
                color: var(--teal-dark);
                font-weight: 600;
            }

    /* CHART */

    .chart-wrap {
        position: relative;
        height: 280px;
    }

    .chart-period {
        font-size: .78rem;
        color: var(--muted);
        background: var(--cream);
        border-radius: 999px;
        padding: .35rem .7rem;
    }

    /* POPULAR */

    .pt-item {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .7rem 0;
        border-top: 1px solid var(--line-2);
    }

        .pt-item:first-child {
            padding-top: .2rem;
            border-top: none;
        }

        .pt-item img {
            width: 48px;
            height: 48px;
            border-radius: 11px;
            object-fit: cover;
            flex: none;
        }

    .tour-img-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 11px;
        background: var(--navy);
        color: #fff;
        display: grid;
        place-items: center;
        font-family: 'Sora';
        font-weight: 700;
        flex: none;
    }

    .pt-item .nm {
        flex: 1;
        min-width: 0;
    }

        .pt-item .nm b {
            font-family: 'Sora';
            font-weight: 600;
            font-size: .88rem;
            color: var(--navy);
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pt-item .nm span {
            font-size: .76rem;
            color: var(--muted);
        }

    .pt-item .rank {
        font-family: 'Sora';
        font-weight: 700;
        color: var(--muted);
        font-size: 1rem;
        width: 20px;
        text-align: center;
    }

    /* TABLE */

    .tbl-wrap {
        overflow-x: auto;
    }

    table.tx {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 850px;
    }

        table.tx th {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--muted);
            font-weight: 600;
            text-align: left;
            padding: .7rem 1rem;
            border-bottom: 1px solid var(--line);
        }

        table.tx td {
            padding: .85rem 1rem;
            border-bottom: 1px solid var(--line-2);
            font-size: .86rem;
            color: var(--navy);
            vertical-align: middle;
        }

        table.tx tr:last-child td {
            border-bottom: none;
        }

    .res-no {
        font-family: 'Sora';
        font-weight: 600;
    }

    .guest {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .guest .av {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: var(--navy-2);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .68rem;
            font-weight: 700;
        }

    .amount {
        font-family: 'Sora';
        font-weight: 600;
    }

    .badge-x {
        font-size: .74rem;
        font-weight: 600;
        padding: .28rem .7rem;
        border-radius: 999px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .badge-x::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .b-ok {
        background: var(--ok-bg);
        color: var(--ok-fg);
    }

    .b-wait {
        background: var(--wait-bg);
        color: var(--wait-fg);
    }

    .b-cancel {
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    .btn-soft {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .4rem .9rem;
        font-size: .8rem;
        font-weight: 600;
        color: var(--navy);
        text-decoration: none;
    }

        .btn-soft:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    /* QUICK ACTIONS */

    .qa-link {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .75rem .85rem;
        border-radius: 12px;
        border: 1px solid var(--line-2);
        color: var(--navy);
        font-weight: 600;
        font-size: .88rem;
        transition: .2s;
        margin-bottom: .6rem;
        background: #fff;
        text-decoration: none;
    }

        .qa-link:hover {
            border-color: var(--teal);
            background: var(--cream);
            color: var(--teal-dark);
        }

    .qa-ic {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        flex: none;
    }

    .qa-link .arr {
        margin-left: auto;
        color: var(--muted);
    }

    .coming-soon {
        color: var(--muted);
        font-size: .85rem;
        padding: 1rem 0;
        line-height: 1.6;
    }

    @@media(max-width:575px) {

        .content {
            padding: 1.1rem;
        }
    }

</style>

<div class="content">

    <!-- HEADER -->

    <div class="page-intro">

        <div>

            <div class="eyebrow">
                Genel Bakış
            </div>

            <h1>
                Travelio Dashboard
            </h1>

            <p>
                Platformdaki güncel tur ve rezervasyon verilerini buradan takip edebilirsiniz.
            </p>

        </div>

        <div class="date-pill">

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2">

                <rect x="3"
                      y="4"
                      width="18"
                      height="18"
                      rx="2" />

                <line x1="16"
                      y1="2"
                      x2="16"
                      y2="6" />

                <line x1="8"
                      y1="2"
                      x2="8"
                      y2="6" />

                <line x1="3"
                      y1="10"
                      x2="21"
                      y2="10" />

            </svg>

            @DateTime.Now.ToString("dd MMMM yyyy", trCulture)

        </div>

    </div>

    <!-- KPI -->

    <div class="row g-3 mb-3">

        <!-- TOTAL TOUR -->

        <div class="col-6 col-xl-3">

            <div class="kpi">

                <div class="top">

                    <div class="ic">

                        <svg width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M3 7h18v12H3z" />

                            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                        </svg>

                    </div>

                </div>

                <div class="num">
                    @Model.TotalTourCount
                </div>

                <div class="lab">
                    Toplam Tur
                </div>

                <div class="sub">

                    <span class="up">
                        @Model.ActiveTourCount aktif /
                        @Model.PassiveTourCount pasif
                    </span>

                </div>

            </div>

        </div>


        <!-- RESERVATIONS -->

        <div class="col-6 col-xl-3">

            <div class="kpi">

                <div class="top">

                    <div class="ic">

                        <svg width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M9 11l3 3L22 4" />

                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />

                        </svg>

                    </div>

                </div>

                <div class="num">
                    @Model.TotalReservationCount
                </div>

                <div class="lab">
                    Toplam Rezervasyon
                </div>

                <div class="sub">

                    <span class="up">
                        Bu ay @Model.ThisMonthReservationCount rezervasyon
                    </span>

                </div>

            </div>

        </div>


        <!-- USERS -->

        <div class="col-6 col-xl-3">

            <div class="kpi">

                <div class="top">

                    <div class="ic">

                        <svg width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />

                            <circle cx="12"
                                    cy="7"
                                    r="4" />

                        </svg>

                    </div>

                </div>

                <div class="num">
                    @Model.TotalUserCount
                </div>

                <div class="lab">
                    Toplam Kullanıcı
                </div>

                <div class="sub">
                    Kayıtlı kullanıcılar
                </div>

            </div>

        </div>


        <!-- QUESTIONS -->

        <div class="col-6 col-xl-3">

            <div class="kpi">

                <div class="top">

                    <div class="ic warn">

                        <svg width="20"
                             height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <circle cx="12"
                                    cy="12"
                                    r="10" />

                            <path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-3 2-3 4" />

                            <line x1="12"
                                  y1="18"
                                  x2="12.01"
                                  y2="18" />

                        </svg>

                    </div>

                </div>

                <div class="num">
                    @Model.PendingQuestionCount
                </div>

                <div class="lab">
                    Bekleyen Soru
                </div>

                <div class="sub">
                    Henüz cevaplanmamış sorular
                </div>

            </div>

        </div>

    </div>


    <!-- CHART + POPULAR -->

    <div class="row g-3 mb-3">

        <!-- CHART -->

        <div class="col-lg-8">

            <div class="card-x h-100">

                <div class="card-head">

                    <h3>
                        Rezervasyon İstatistikleri
                    </h3>

                    <span class="chart-period">
                        Son 6 Ay
                    </span>

                </div>

                <div class="card-body">

                    <div class="chart-wrap">

                        <canvas id="resChart"></canvas>

                    </div>

                </div>

            </div>

        </div>

        <!-- POPULAR TOURS -->

        <div class="col-lg-4">

            <div class="card-x h-100">

                <div class="card-head">

                    <h3>
                        En Popüler Turlar
                    </h3>

                </div>

                <div class="card-body pt-2">

                    @if (Model.PopularTours.Any())
                    {
                        var rank = 1;

                        foreach (var tour in Model.PopularTours)
                        {
                            <div class="pt-item">

                                <span class="rank">
                                    @rank
                                </span>

                                @if (!string.IsNullOrWhiteSpace(tour.CoverImageUrl))
                                {
                                    <img src="@tour.CoverImageUrl"
                                         alt="@tour.TourName" />
                                }
                                else
                                {
                                    <div class="tour-img-placeholder">
                                        TR
                                    </div>
                                }

                                <div class="nm">

                                    <b>
                                        @tour.TourName
                                    </b>

                                    <span>
                                        @tour.ReservationCount rezervasyon
                                    </span>

                                </div>

                            </div>

                            rank++;
                        }
                    }
                    else
                    {
                        <div class="coming-soon">
                            Henüz rezervasyon verisi bulunmuyor.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- RECENT RESERVATIONS -->

    <div class="card-x mb-3">

        <div class="card-head">

            <h3>
                Son Rezervasyonlar
            </h3>

            <a href='@Url.Action("Index", "Reservation", new { area = "Admin" })'
                   class="btn-soft">

                Tümünü Gör

            </a>

        </div>

        <div class="card-body pt-2">

            @if (Model.RecentReservations.Any())
            {
                <div class="tbl-wrap">

                    <table class="tx">

                        <thead>

                            <tr>

                                <th>
                                    Rezervasyon
                                </th>

                                <th>
                                    Kullanıcı
                                </th>

                                <th>
                                    Tur
                                </th>

                                <th>
                                    Tur Tarihi
                                </th>

                                <th>
                                    Kişi
                                </th>

                                <th>
                                    Tutar
                                </th>

                                <th>
                                    Durum
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var reservation in Model.RecentReservations)
                            {
                                var personCount =
                                    reservation.AdultCount +
                                    reservation.ChildCount;

                                var badgeClass =
                                    reservation.Status == "Onaylandı"
                                        ? "b-ok"
                                        : reservation.Status == "İptal Edildi"
                                            ? "b-cancel"
                                            : "b-wait";

                                <tr>

                                    <td>

                                        <span class="res-no">

                                            @(reservation.Id.Length > 8
                                                ? reservation.Id.Substring(reservation.Id.Length - 8)
                                                : reservation.Id)

                                        </span>

                                    </td>

                                    <td>
                                        <div class="guest">

                                            <span class="av">
                                                @(string.IsNullOrWhiteSpace(reservation.UserName)
                                                    ? "U"
                                                    : reservation.UserName.Substring(0, 1).ToUpper())
                                            </span>

                                            <span>
                                                @reservation.UserName
                                            </span>

                                        </div>
                                    </td>

                                    <td>
                                        @reservation.TourName
                                    </td>

                                    <td>

                                        @reservation.SelectedTourDate.ToString("dd.MM.yyyy")

                                    </td>

                                    <td>
                                        @personCount kişi
                                    </td>

                                    <td>

                                        <span class="amount">

                                            @reservation.TotalPrice.ToString("N0") TL

                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge-x @badgeClass">

                                            @reservation.Status

                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="coming-soon">
                    Henüz rezervasyon bulunmuyor.
                </div>
            }

        </div>

    </div>

    <!-- BOTTOM -->

    <div class="row g-3">

        <!-- COMMENTS -->

        <div class="col-lg-4">

            <div class="card-x h-100">

                <div class="card-head">

                    <h3>
                        Son Yorumlar
                    </h3>

                </div>

                <div class="card-body pt-2">

                    <div class="coming-soon">
                        Yorumları görüntülemek ve yönetmek için yorum sayfasına geçebilirsiniz.
                    </div>

                    <a href='@Url.Action("Index", "Comment", new { area = "Admin" })'
                           class="btn-soft">
                        Yorumları Gör
                    </a>

                </div>

            </div>

        </div>

        <!-- QUESTIONS -->

        <div class="col-lg-4">

            <div class="card-x h-100">

                <div class="card-head">

                    <h3>
                        Yanıt Bekleyen Sorular
                    </h3>

                </div>

                <div class="card-body pt-2">

                    <div class="coming-soon">
                        Kullanıcı sorularını görüntülemek ve yanıtlamak için sorular sayfasına geçebilirsiniz.
                    </div>

                    <a href='@Url.Action("Index", "Question", new { area = "Admin" })'
                           class="btn-soft">
                        Soruları Gör
                    </a>

                </div>

            </div>

        </div>

        <!-- QUICK ACTIONS -->

        <div class="col-lg-4">

            <div class="card-x h-100">

                <div class="card-head">

                    <h3>
                        Hızlı İşlemler
                    </h3>

                </div>

                <div class="card-body pt-2">

                    <a href='@Url.Action("Create", "Tour", new { area = "Admin" })'
                           class="qa-link">

                        <span class="qa-ic">
                            +
                        </span>

                        Yeni Tur Ekle

                        <span class="arr">
                            →
                        </span>

                    </a>

                    <a href='@Url.Action("Index", "Reservation", new { area = "Admin" })'
                           class="qa-link">

                        <span class="qa-ic">
                            R
                        </span>

                        Rezervasyonları Gör

                        <span class="arr">
                            →
                        </span>

                    </a>

                    <a href='@Url.Action("Create", "Category", new { area = "Admin" })'
                           class="qa-link">

                        <span class="qa-ic">
                            K
                        </span>

                        Yeni Kategori Ekle

                        <span class="arr">
                            →
                        </span>

                    </a>

                    <a href='@Url.Action("Create", "Destination", new { area = "Admin" })'
                           class="qa-link">

                        <span class="qa-ic">
                            D
                        </span>

                        Yeni Destinasyon Ekle

                        <span class="arr">
                            →
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
    const chartLabels = @Html.Raw(JsonSerializer.Serialize(Model.ChartLabels));
    const chartData = @Html.Raw(JsonSerializer.Serialize(Model.ChartReservationCounts));

    const ctx = document.getElementById("resChart");
    const context = ctx.getContext("2d");

    const grad = context.createLinearGradient(0, 0, 0, 280);
    grad.addColorStop(0, "rgba(15,163,163,.28)");
    grad.addColorStop(1, "rgba(15,163,163,0)");

    new Chart(ctx, {
    type: "line",
    data: {
    labels: chartLabels,
    datasets: [
    {
    label: "Rezervasyon",
    data: chartData,
    borderColor: "#0fa3a3",
    backgroundColor: grad,
    borderWidth: 3,
    fill: true,
    tension: .38,
    pointBackgroundColor: "#fff",
    pointBorderColor: "#0fa3a3",
    pointBorderWidth: 2.5,
    pointRadius: 4,
    pointHoverRadius: 6
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
    legend: {
    display: false
    },
    tooltip: {
    backgroundColor: "#0e2a3b",
    padding: 12,
    cornerRadius: 10,
    displayColors: false,
    callbacks: {
    label: context => context.parsed.y + " rezervasyon"
    }
    }
    },
    scales: {
    y: {
    beginAtZero: true,
    ticks: {
    precision: 0,
    color: "#6a7c88"
    },
    grid: {
    color: "#eef0ef"
    }
    },
    x: {
    grid: {
    display: false
    },
    ticks: {
    color: "#6a7c88"
    }
    }
    }
    }
    });
</script>


