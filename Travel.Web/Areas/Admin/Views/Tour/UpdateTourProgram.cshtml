@using Travel.Web.DTOs.TourDtos
@model UpdateTourProgramDto

@{
    ViewData["Title"] = "Tur Programı Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-shell{max-width:1100px}
    .sec{background:#fff;border:1px solid var(--line-2);border-radius:var(--r);box-shadow:var(--shadow-sm);padding:1.5rem}
    .field{margin-bottom:1rem}
    .field label{display:block;font-size:.8rem;font-weight:600;color:var(--navy);margin-bottom:.35rem}
    .ctrl{width:100%;border:1px solid var(--line);background:var(--cream);border-radius:11px;padding:.7rem .9rem;outline:none;color:var(--navy)}
    .ctrl:focus{border-color:var(--teal);background:#fff}
    textarea.ctrl{min-height:120px}
    .btn-teal{background:var(--teal);color:#fff;border:none;border-radius:999px;padding:.7rem 1.3rem;font-weight:600}
    .btn-ghost{background:#fff;border:1px solid var(--line);border-radius:999px;padding:.7rem 1.3rem;color:var(--navy);text-decoration:none}
    .text-danger{font-size:.78rem}
</style>

<div class="content">
    <div class="form-shell">

        <h1 style="font-family:Sora;color:var(--navy);font-size:1.7rem;">
            Program Gününü Güncelle
        </h1>

        <div class="sec mt-4">

            <form asp-area="Admin"
                  asp-controller="Tour"
                  asp-action="UpdateTourProgram"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       name="tourId"
                       value="@ViewBag.TourId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-4 field">
                        <label>Gün Numarası</label>

                        <input asp-for="DayNumber"
                               type="number"
                               min="1"
                               class="ctrl" />

                        <span asp-validation-for="DayNumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-8 field">
                        <label>Başlık</label>

                        <input asp-for="Title"
                               class="ctrl" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="field">
                    <label>Açıklama</label>

                    <textarea asp-for="Description"
                              class="ctrl"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="row">

                    <div class="col-md-4 field">
                        <label>Şehir</label>

                        <input asp-for="City"
                               class="ctrl" />
                    </div>

                    <div class="col-md-4 field">
                        <label>Ulaşım</label>

                        <input asp-for="Transport"
                               class="ctrl" />
                    </div>

                    <div class="col-md-4 field">
                        <label>Öğün</label>

                        <input asp-for="Meal"
                               class="ctrl" />
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-area="Admin"
                       asp-controller="Tour"
                       asp-action="Details"
                       asp-route-id="@ViewBag.TourId"
                       class="btn-ghost">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn-teal">
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>