@using Travel.Web.Areas.Admin.Models
@using System.Linq
@model List<AdminTourListViewModel>

@{
    ViewData["Title"] = "Tur Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var tours = Model ?? new List<AdminTourListViewModel>();

    var totalTourCount = tours.Count;
    var activeTourCount = tours.Count(x => x.Tour.IsActive);
    var passiveTourCount = tours.Count(x => !x.Tour.IsActive);

    var totalCapacity = tours.Sum(x =>
        x.Tour.TourDates?.Sum(d => d.Capacity) ?? 0);

    var destinations = tours
        .Select(x => x.DestinationName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var categories = tours
        .Select(x => x.CategoryName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>

    .content {
        padding: 1.8rem;
        flex: 1;
    }

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 60ch;
        }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 12px 26px rgba(15,163,163,.3);
        }

    .kpi {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        align-items: center;
        gap: .85rem;
    }

        .kpi .ic {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            flex: none;
        }

            .kpi .ic.gray {
                background: rgba(106,124,136,.12);
                color: var(--muted);
            }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .82rem;
            color: var(--muted);
            margin-top: .15rem;
        }

    .card-x {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
    }

    .filter-bar {
        padding: 1rem 1.1rem;
    }

    .f-search {
        position: relative;
    }

        .f-search svg {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .f-search input {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .62rem .9rem .62rem 2.3rem;
            font-size: .9rem;
            outline: none;
            color: var(--navy);
        }

            .f-search input:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.1);
            }

    .f-select {
        width: 100%;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 11px;
        padding: .62rem 2rem .62rem .9rem;
        font-size: .88rem;
        font-weight: 500;
        color: var(--navy);
        outline: none;
        cursor: pointer;
    }

        .f-select:focus {
            border-color: var(--teal);
        }

    .btn-clear {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 11px;
        padding: .62rem 1rem;
        font-size: .86rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
        white-space: nowrap;
        width: 100%;
    }

        .btn-clear:hover {
            border-color: var(--cancel-fg);
            color: var(--cancel-fg);
        }

    .result-line {
        font-size: .86rem;
        color: var(--muted);
        margin: .2rem 0 1rem;
        padding: 0 .2rem;
    }

        .result-line b {
            color: var(--navy);
        }

    .bulk-bar {
        display: none;
        align-items: center;
        gap: .8rem;
        background: var(--navy);
        color: #fff;
        border-radius: 12px;
        padding: .6rem 1rem;
        margin-bottom: 1rem;
    }

        .bulk-bar.show {
            display: flex;
        }

        .bulk-bar b {
            font-family: 'Sora';
            font-size: .9rem;
        }

        .bulk-bar .bulk-btn {
            margin-left: auto;
            background: rgba(255,255,255,.12);
            border: none;
            color: #fff;
            border-radius: 999px;
            padding: .35rem .9rem;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
        }

            .bulk-bar .bulk-btn + .bulk-btn {
                margin-left: .5rem;
            }

            .bulk-bar .bulk-btn:hover {
                background: rgba(255,255,255,.22);
            }

    /*
                Dropdown'ın tablo tarafından kesilmemesi için
                visible bırakıyoruz.
            */
    .tbl-wrap {
        overflow: visible;
    }

    table.tx {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 1020px;
    }

        table.tx th {
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--muted);
            font-weight: 600;
            text-align: left;
            padding: .75rem 1rem;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

            table.tx th.sortable {
                cursor: pointer;
                user-select: none;
            }

                table.tx th.sortable:hover {
                    color: var(--teal-dark);
                }

            table.tx th .sar {
                opacity: .4;
                margin-left: .2rem;
            }

            table.tx th.sorted .sar {
                opacity: 1;
                color: var(--teal-dark);
            }

        table.tx td {
            padding: .8rem 1rem;
            border-bottom: 1px solid var(--line-2);
            font-size: .88rem;
            color: var(--navy);
            vertical-align: middle;
        }

        table.tx tbody tr:hover {
            background: var(--cream);
        }

    .chk {
        width: 17px;
        height: 17px;
        accent-color: var(--teal-dark);
        cursor: pointer;
    }

    .tour-cell {
        display: flex;
        align-items: center;
        gap: .7rem;
        min-width: 220px;
    }

        .tour-cell img {
            width: 52px;
            height: 52px;
            border-radius: 11px;
            object-fit: cover;
            flex: none;
        }

    .tour-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background: var(--navy);
        color: #fff;
        font-weight: 700;
        flex: none;
    }

    .tour-cell b {
        font-family: 'Sora';
        font-weight: 600;
        font-size: .9rem;
        color: var(--navy);
        display: block;
        line-height: 1.25;
    }

    .tour-cell span {
        font-size: .78rem;
        color: var(--teal-dark);
        font-weight: 500;
    }

    .cat-pill {
        font-size: .76rem;
        color: var(--navy);
        background: var(--cream);
        border: 1px solid var(--line);
        padding: .22rem .6rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .amount {
        font-family: 'Sora';
        font-weight: 600;
        white-space: nowrap;
    }

    .muted-cell {
        color: var(--muted);
        white-space: nowrap;
    }

    .badge-x {
        font-size: .74rem;
        font-weight: 600;
        padding: .28rem .7rem;
        border-radius: 999px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .badge-x::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .b-ok {
        background: var(--ok-bg);
        color: var(--ok-fg);
    }

    .b-pasif {
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    .act-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid var(--line);
        display: grid;
        place-items: center;
        color: var(--muted);
        cursor: pointer;
    }

        .act-btn:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .dropdown-menu {
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: var(--shadow-md);
        padding: .4rem;
        font-size: .88rem;
        min-width: 180px;
    }

    .dropdown-item {
        border-radius: 8px;
        padding: .5rem .7rem;
        font-weight: 500;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .dropdown-item:hover {
            background: var(--cream);
            color: var(--teal-dark);
        }

        .dropdown-item.danger {
            color: var(--cancel-fg);
        }

    .pager-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1rem 1.1rem;
    }

    .pager {
        display: flex;
        gap: .35rem;
    }

        .pager a {
            min-width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--navy);
            font-weight: 600;
            font-size: .88rem;
            padding: 0 .5rem;
            text-decoration: none;
        }

            .pager a.active {
                background: var(--navy);
                color: #fff;
                border-color: var(--navy);
            }

            .pager a.disabled {
                opacity: .45;
                pointer-events: none;
            }

    .per-page {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .per-page select {
            border: 1px solid var(--line);
            border-radius: 9px;
            padding: .35rem .6rem;
        }

    .empty {
        text-align: center;
        padding: 3.5rem 1rem;
    }

        .empty h3 {
            font-family: 'Sora';
            color: var(--navy);
        }

        .empty p {
            color: var(--muted);
        }

    .modal-content {
        border-radius: var(--r);
        border: none;
    }

    @@media(max-width:575px) {

        .content {
            padding: 1.1rem;
        }
    }

</style>


<div class="content">

    <!-- BREADCRUMB -->
    <div class="crumb">

        <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">
            Dashboard
        </a>

        /

        <span class="cur">Turlar</span>

    </div>


    <!-- HEADER -->
    <div class="page-intro">

        <div>

            <h1>Tur Yönetimi</h1>

            <p>
                Travelio'daki tüm turları görüntüleyebilir,
                filtreleyebilir ve yönetebilirsiniz.
            </p>

        </div>


        <a asp-area="Admin"
               asp-controller="Tour"
               asp-action="Create"
               class="btn-teal">

            <svg width="17"
                 height="17"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.2">

                <line x1="12"
                      y1="5"
                      x2="12"
                      y2="19" />

                <line x1="5"
                      y1="12"
                      x2="19"
                      y2="12" />

            </svg>

            Yeni Tur Ekle

        </a>

    </div>


    <!-- KPI -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">
                    T
                </div>

                <div>

                    <div class="num">
                        @totalTourCount
                    </div>

                    <div class="lab">
                        Toplam Tur
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">
                    ✓
                </div>

                <div>

                    <div class="num">
                        @activeTourCount
                    </div>

                    <div class="lab">
                        Aktif Tur
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic gray">
                    −
                </div>

                <div>

                    <div class="num">
                        @passiveTourCount
                    </div>

                    <div class="lab">
                        Pasif Tur
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">
                    K
                </div>

                <div>

                    <div class="num">
                        @totalCapacity
                    </div>

                    <div class="lab">
                        Kalan Kontenjan
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FILTER -->
    <div class="card-x filter-bar mb-3">

        <div class="row g-2 align-items-center">


            <!-- SEARCH -->
            <div class="col-lg-4 col-md-6">

                <div class="f-search">

                    <svg width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="11"
                                cy="11"
                                r="8" />

                        <line x1="21"
                              y1="21"
                              x2="16.65"
                              y2="16.65" />

                    </svg>

                    <input type="text"
                           id="fSearch"
                           placeholder="Tur adı, ülke veya destinasyon ara..." />

                </div>

            </div>


            <!-- DESTINATION -->
            <div class="col-lg-3 col-md-6">

                <select class="f-select"
                        id="fDest">

                    <option value="">
                        Tüm Destinasyonlar
                    </option>

                    @foreach (var destination in destinations)
                    {
                        <option value="@destination">
                            @destination
                        </option>
                    }

                </select>

            </div>


            <!-- CATEGORY -->
            <div class="col-lg-2 col-md-4">

                <select class="f-select"
                        id="fCat">

                    <option value="">
                        Tüm Kategoriler
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category">
                            @category
                        </option>
                    }

                </select>

            </div>


            <!-- STATUS -->
            <div class="col-lg-2 col-md-4">

                <select class="f-select"
                        id="fStatus">

                    <option value="">
                        Tüm Durumlar
                    </option>

                    <option value="Aktif">
                        Aktif
                    </option>

                    <option value="Pasif">
                        Pasif
                    </option>

                </select>

            </div>


            <!-- CLEAR -->
            <div class="col-lg-1 col-md-4">

                <button type="button"
                        class="btn-clear"
                        onclick="clearFilters()">

                    Temizle

                </button>

            </div>

        </div>

    </div>


    <!-- RESULT -->
    <div class="result-line">

        <b id="resultCount">
            @totalTourCount
        </b>

        tur listeleniyor

    </div>


    <!-- BULK -->
    <div class="bulk-bar"
         id="bulkBar">

        <b id="bulkCount">
            0 tur seçildi
        </b>

        <button type="button"
                class="bulk-btn"
                onclick="bulkStatus('Aktif')">

            Aktif Yap

        </button>

        <button type="button"
                class="bulk-btn"
                onclick="bulkStatus('Pasif')">

            Pasif Yap

        </button>

        <button type="button"
                class="bulk-btn"
                onclick="bulkDelete()">

            Sil

        </button>

    </div>


    <!-- TABLE -->
    <div class="card-x mb-3">

        <div class="tbl-wrap">

            <table class="tx">

                <thead>

                    <tr>

                        <th style="width:36px">

                            <input type="checkbox"
                                   class="chk"
                                   id="checkAll"
                                   onchange="toggleAll(this)" />

                        </th>


                        <th class="sortable"
                            onclick="sortBy('title', this)">

                            Tur

                            <span class="sar">
                                ↕
                            </span>

                        </th>


                        <th>
                            Kategori
                        </th>


                        <th>
                            Süre
                        </th>


                        <th class="sortable"
                            onclick="sortBy('price', this)">

                            Fiyat

                            <span class="sar">
                                ↕
                            </span>

                        </th>


                        <th class="sortable"
                            onclick="sortBy('date', this)">

                            Yaklaşan Tarih

                            <span class="sar">
                                ↕
                            </span>

                        </th>


                        <th>
                            Kontenjan
                        </th>


                        <th class="sortable"
                            onclick="sortBy('res', this)">

                            Rezervasyon

                            <span class="sar">
                                ↕
                            </span>

                        </th>


                        <th>
                            Durum
                        </th>


                        <th style="width:56px">
                            İşlemler
                        </th>

                    </tr>

                </thead>


                <tbody id="tourRows">

                    @foreach (var item in tours)
                    {
                        var nextDate = item.Tour.TourDates?
                            .Where(x => x.Date >= DateTime.Today)
                            .OrderBy(x => x.Date)
                            .FirstOrDefault();

                        var status =
                            item.Tour.IsActive
                                ? "Aktif"
                                : "Pasif";


                        <tr class="tour-row"
                            data-id="@item.Tour.Id"
                            data-title="@item.Tour.TourName"
                            data-country="@item.Tour.Country"
                            data-destination="@item.DestinationName"
                            data-category="@item.CategoryName"
                            data-status="@status"
                            data-price="@item.Tour.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-date="@(nextDate?.Date.ToString("yyyy-MM-dd") ?? "")"
                            data-res="@item.ReservationCount">


                            <!-- CHECKBOX -->
                            <td>

                                <input type="checkbox"
                                       class="chk row-chk"
                                       value="@item.Tour.Id"
                                       onchange="updateBulk()" />

                            </td>


                            <!-- TOUR -->
                            <td>

                                <div class="tour-cell">

                                    @if (!string.IsNullOrWhiteSpace(item.Tour.CoverImageUrl))
                                    {
                                        <img src="@item.Tour.CoverImageUrl"
                                             alt="@item.Tour.TourName" />
                                    }
                                    else
                                    {
                                        <div class="tour-placeholder">
                                            TR
                                        </div>
                                    }


                                    <div>

                                        <b>
                                            @item.Tour.TourName
                                        </b>

                                        <span>

                                            @item.DestinationName

                                            @if (!string.IsNullOrWhiteSpace(item.Tour.Country))
                                            {
                                                <text> · @item.Tour.Country</text>
                                            }

                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- CATEGORY NAME -->
                            <td>

                                <span class="cat-pill">
                                    @item.CategoryName
                                </span>

                            </td>


                            <!-- DURATION -->
                            <td class="muted-cell">

                                @item.Tour.Day Gün /
                                @item.Tour.Night Gece

                            </td>


                            <!-- PRICE -->
                            <td>

                                <span class="amount">

                                    @item.Tour.Price.ToString("N0") TL

                                </span>

                            </td>


                            <!-- NEXT DATE -->
                            <td class="muted-cell">

                                @(nextDate != null
                                    ? nextDate.Date.ToString("dd.MM.yyyy")
                                    : "Tarih Yok")

                            </td>


                            <!-- CAPACITY -->
                            <td>

                                @(nextDate != null
                                    ? nextDate.Capacity
                                    : 0)

                            </td>


                            <!-- RESERVATION -->
                            <td style="font-weight:600">

                                @item.ReservationCount

                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.Tour.IsActive)
                                {
                                    <span class="badge-x b-ok">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-x b-pasif">
                                        Pasif
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td>

                                <div class="dropdown">

                                    <button type="button"
                                            class="act-btn"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">

                                        ⋮

                                    </button>


                                    <ul class="dropdown-menu dropdown-menu-end">


                                        <!-- DETAILS -->
                                        <li>

                                            <a class="dropdown-item"
                                                   asp-area="Admin"
                                                   asp-controller="Tour"
                                                   asp-action="Details"
                                                   asp-route-id="@item.Tour.Id">

                                                Görüntüle

                                            </a>

                                        </li>


                                        <!-- UPDATE -->
                                        <li>

                                            <a class="dropdown-item"
                                                   asp-area="Admin"
                                                   asp-controller="Tour"
                                                   asp-action="Update"
                                                   asp-route-id="@item.Tour.Id">

                                                Düzenle

                                            </a>

                                        </li>


                                        <!-- STATUS -->
                                        <li>

                                            <a class="dropdown-item"
                                                   asp-area="Admin"
                                                   asp-controller="Tour"
                                                   asp-action="ChangeStatus"
                                                   asp-route-id="@item.Tour.Id">

                                                @(item.Tour.IsActive
                                                    ? "Pasif Yap"
                                                    : "Aktif Yap")

                                            </a>

                                        </li>


                                        <!-- DELETE -->
                                        <li>

                                            <button type="button"
                                                    class="dropdown-item danger btn-delete"
                                                    data-name="@item.Tour.TourName"
                                                    data-url="@Url.Action(
                                                                                                                                                                                                                                                                "Delete",
                                                                                                                                                                                                                                                                "Tour",
                                                                                                                                                                                                                                                                new
                                                                                                                                                                                                                                                                {
                                                                                                                                                                                                                                                                    area = "Admin",
                                                                                                                                                                                                                                                                    id = item.Tour.Id
                                                                                                                                                                                                                                                                })">

                                                Sil

                                            </button>

                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- EMPTY -->
        <div id="emptyState"
             style="display:none">

            <div class="empty">

                <h3>
                    Tur bulunamadı
                </h3>

                <p>
                    Arama veya filtre kriterlerinizi değiştirerek
                    tekrar deneyebilirsiniz.
                </p>

                <button type="button"
                        class="btn-teal"
                        onclick="clearFilters()">

                    Filtreleri Temizle

                </button>

            </div>

        </div>


        <!-- PAGINATION -->
        <div class="pager-row"
             id="pagerRow">

            <div class="per-page">

                Sayfa başına

                <select id="perPage">

                    <option value="10">
                        10
                    </option>

                    <option value="25">
                        25
                    </option>

                    <option value="50">
                        50
                    </option>

                </select>

            </div>


            <div class="pager"
                 id="pager">
            </div>

        </div>

    </div>

</div>


<!-- DELETE MODAL -->
<div class="modal fade"
     id="delModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body text-center p-4">

                <h5 style="
                    font-family:'Sora';
                    font-weight:700;
                    color:var(--navy)">

                    Turu Sil

                </h5>


                <p id="delMsg"
                       style="
                    color:var(--muted);
                    font-size:.92rem">
                </p>


                <p style="
                    color:var(--muted);
                    font-size:.82rem">

                    Bu işlem geri alınamaz.

                </p>


                <div class="d-flex gap-2 justify-content-center mt-3">

                    <button type="button"
                            class="btn-clear"
                            style="width:auto"
                            data-bs-dismiss="modal">

                        Vazgeç

                    </button>


                    <a href="#"
                           id="confirmDeleteBtn"
                           class="btn-teal"
                           style="background:var(--cancel-fg)">

                        Turu Sil

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    let sortKey = null;
    let sortDirection = 1;
    let currentPage = 1;


    function getRows() {

        return Array.from(
            document.querySelectorAll(
                "#tourRows .tour-row"
            )
        );

    }


    function normalize(value) {

        return (value || "")
            .toLocaleLowerCase("tr-TR");

    }


    function applyTable() {

        const search =
            normalize(
                document
                    .getElementById("fSearch")
                    .value
            );


        const destination =
            document
                .getElementById("fDest")
                .value;


        const category =
            document
                .getElementById("fCat")
                .value;


        const status =
            document
                .getElementById("fStatus")
                .value;


        let rows = getRows();


        /*
            SORT
        */
        if (sortKey) {

            rows.sort((a, b) => {

                let first;
                let second;


                if (sortKey === "price") {

                    first =
                        parseFloat(
                            a.dataset.price || "0"
                        );

                    second =
                        parseFloat(
                            b.dataset.price || "0"
                        );

                    return (first - second)
                        * sortDirection;

                }


                if (sortKey === "res") {

                    first =
                        parseInt(
                            a.dataset.res || "0"
                        );

                    second =
                        parseInt(
                            b.dataset.res || "0"
                        );

                    return (first - second)
                        * sortDirection;

                }


                if (sortKey === "date") {

                    first =
                        a.dataset.date ||
                        "9999-12-31";

                    second =
                        b.dataset.date ||
                        "9999-12-31";

                    return first
                        .localeCompare(second)
                        * sortDirection;

                }


                first =
                    normalize(
                        a.dataset.title
                    );

                second =
                    normalize(
                        b.dataset.title
                    );


                return first.localeCompare(
                    second,
                    "tr"
                ) * sortDirection;

            });


            const tbody =
                document
                    .getElementById("tourRows");


            rows.forEach(row => {

                tbody.appendChild(row);

            });

        }


        /*
            FILTER
        */
        const filteredRows =
            rows.filter(row => {


                const title =
                    normalize(
                        row.dataset.title
                    );


                const country =
                    normalize(
                        row.dataset.country
                    );


                const rowDestination =
                    row.dataset.destination || "";


                const rowCategory =
                    row.dataset.category || "";


                const rowStatus =
                    row.dataset.status || "";


                /*
                    Search:
                    Tur adı
                    Ülke
                    Destination adı
                */
                if (
                    search &&
                    !title.includes(search) &&
                    !country.includes(search) &&
                    !normalize(rowDestination)
                        .includes(search)
                ) {

                    return false;

                }


                /*
                    Destination filtresi
                */
                if (
                    destination &&
                    rowDestination !== destination
                ) {

                    return false;

                }


                /*
                    Category filtresi
                */
                if (
                    category &&
                    rowCategory !== category
                ) {

                    return false;

                }


                /*
                    Status filtresi
                */
                if (
                    status &&
                    rowStatus !== status
                ) {

                    return false;

                }


                return true;

            });


        /*
            RESULT COUNT
        */
        document
            .getElementById("resultCount")
            .textContent =
            filteredRows.length;


        /*
            PAGE SIZE
        */
        const perPage =
            parseInt(
                document
                    .getElementById("perPage")
                    .value
            );


        const totalPages =
            Math.max(
                1,
                Math.ceil(
                    filteredRows.length /
                    perPage
                )
            );


        if (currentPage > totalPages) {

            currentPage =
                totalPages;

        }


        /*
            Önce tüm satırları gizle
        */
        rows.forEach(row => {

            row.style.display =
                "none";

        });


        const start =
            (currentPage - 1)
            * perPage;


        const end =
            start + perPage;


        /*
            Sadece aktif sayfayı göster
        */
        filteredRows
            .slice(start, end)
            .forEach(row => {

                row.style.display =
                    "";

            });


        /*
            EMPTY STATE
        */
        document
            .getElementById("emptyState")
            .style.display =
            filteredRows.length === 0
                ? "block"
                : "none";


        /*
            PAGER
        */
        document
            .getElementById("pagerRow")
            .style.display =
            filteredRows.length === 0
                ? "none"
                : "flex";


        renderPager(totalPages);

        updateBulk();

    }


    /*
        SORT
    */
    function sortBy(
        key,
        element
    ) {

        if (sortKey === key) {

            sortDirection *= -1;

        }
        else {

            sortKey = key;
            sortDirection = 1;

        }


        document
            .querySelectorAll(
                "th.sortable"
            )
            .forEach(th => {

                th.classList
                    .remove("sorted");


                const arrow =
                    th.querySelector(".sar");


                if (arrow) {

                    arrow.textContent =
                        "↕";

                }

            });


        element.classList
            .add("sorted");


        element
            .querySelector(".sar")
            .textContent =
            sortDirection === 1
                ? "↑"
                : "↓";


        applyTable();

    }


    /*
        PAGER
    */
    function renderPager(
        totalPages
    ) {

        const pager =
            document
                .getElementById("pager");


        pager.innerHTML = "";


        createPagerButton(
            "Önceki",
            currentPage - 1,
            currentPage === 1
        );


        for (
            let page = 1;
            page <= totalPages;
            page++
        ) {

            createPagerButton(
                page,
                page,
                false,
                page === currentPage
            );

        }


        createPagerButton(
            "Sonraki",
            currentPage + 1,
            currentPage === totalPages
        );

    }


    function createPagerButton(
        text,
        page,
        disabled,
        active = false
    ) {

        const pager =
            document
                .getElementById("pager");


        const link =
            document.createElement("a");


        link.href = "#";
        link.textContent = text;


        if (disabled) {

            link.classList
                .add("disabled");

        }


        if (active) {

            link.classList
                .add("active");

        }


        link.addEventListener(
            "click",
            function (event) {

                event.preventDefault();


                if (disabled) {

                    return;

                }


                currentPage =
                    page;


                applyTable();

            }
        );


        pager.appendChild(link);

    }


    /*
        CLEAR FILTERS
    */
    function clearFilters() {

        document
            .getElementById("fSearch")
            .value = "";


        document
            .getElementById("fDest")
            .value = "";


        document
            .getElementById("fCat")
            .value = "";


        document
            .getElementById("fStatus")
            .value = "";


        sortKey = null;
        sortDirection = 1;
        currentPage = 1;


        applyTable();

    }


    /*
        CHECK ALL
    */
    function toggleAll(
        checkbox
    ) {

        getRows()
            .filter(row =>
                row.style.display !== "none"
            )
            .forEach(row => {

                const box =
                    row.querySelector(
                        ".row-chk"
                    );


                if (box) {

                    box.checked =
                        checkbox.checked;

                }

            });


        updateBulk();

    }


    function getSelectedRows() {

        return getRows()
            .filter(row => {

                const checkbox =
                    row.querySelector(
                        ".row-chk"
                    );


                return checkbox &&
                    checkbox.checked;

            });

    }


    function updateBulk() {

        const selectedRows =
            getSelectedRows();


        const bulkBar =
            document
                .getElementById("bulkBar");


        bulkBar.classList.toggle(
            "show",
            selectedRows.length > 0
        );


        document
            .getElementById("bulkCount")
            .textContent =
            selectedRows.length +
            " tur seçildi";

    }


    /*
        BULK STATUS
    */
    async function bulkStatus(
        targetStatus
    ) {

        const selectedRows =
            getSelectedRows();


        if (
            selectedRows.length === 0
        ) {

            return;

        }


        const baseUrl =
            '@Url.Action(
                                                                "ChangeStatus",
                                                                "Tour",
                                                                new { area = "Admin" }
                                                )';


        const rowsToChange =
            selectedRows.filter(
                row =>
                    row.dataset.status
                    !== targetStatus
            );


        await Promise.all(

            rowsToChange.map(row => {

                const id =
                    row.dataset.id;


                return fetch(
                    baseUrl +
                    "?id=" +
                    encodeURIComponent(id)
                );

            })

        );


        window.location.reload();

    }


    /*
        BULK DELETE
    */
    async function bulkDelete() {

        const selectedRows =
            getSelectedRows();


        if (
            selectedRows.length === 0
        ) {

            return;

        }


        const approved =
            confirm(
                selectedRows.length +
                " tur silinecek. Emin misiniz?"
            );


        if (!approved) {

            return;

        }


        const baseUrl =
            '@Url.Action(
                                                                "Delete",
                                                                "Tour",
                                                                new { area = "Admin" }
                                                )';


        await Promise.all(

            selectedRows.map(row => {

                const id =
                    row.dataset.id;


                return fetch(
                    baseUrl +
                    "?id=" +
                    encodeURIComponent(id)
                );

            })

        );


        window.location.reload();

    }


    /*
        DELETE MODAL
    */
    document
        .querySelectorAll(
            ".btn-delete"
        )
        .forEach(button => {

            button.addEventListener(
                "click",
                function () {

                    const tourName =
                        this.dataset.name;


                    const deleteUrl =
                        this.dataset.url;


                    document
                        .getElementById("delMsg")
                        .textContent =
                        '"' +
                        tourName +
                        '" turunu silmek istediğinize emin misiniz?';


                    document
                        .getElementById(
                            "confirmDeleteBtn"
                        )
                        .href =
                        deleteUrl;


                    const modal =
                        new bootstrap.Modal(
                            document
                                .getElementById(
                                    "delModal"
                                )
                        );


                    modal.show();

                }
            );

        });


    /*
        SEARCH
    */
    document
        .getElementById("fSearch")
        .addEventListener(
            "input",
            function () {

                currentPage = 1;

                applyTable();

            }
        );


    /*
        SELECT FILTERS
    */
    [
        "fDest",
        "fCat",
        "fStatus"
    ]
        .forEach(id => {

            document
                .getElementById(id)
                .addEventListener(
                    "change",
                    function () {

                        currentPage = 1;

                        applyTable();

                    }
                );

        });


    /*
        PAGE SIZE
    */
    document
        .getElementById("perPage")
        .addEventListener(
            "change",
            function () {

                currentPage = 1;

                applyTable();

            }
        );


    /*
        FIRST LOAD
    */
    applyTable();

</script>